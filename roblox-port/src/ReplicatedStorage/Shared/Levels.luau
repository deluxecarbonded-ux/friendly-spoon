local Levels = {}

local function R(ch, n) return string.rep(ch, n) end

local function grid(W, H, pieces)
  local g = {}
  for r = 1, H do g[r] = {} for c = 1, W do g[r][c] = " " end end
  for _, p in ipairs(pieces) do
    local r, c, s = p[1], p[2], p[3]
    for i = 1, #s do
      if r>=1 and r<=H and c+i-1>=1 and c+i-1<=W then g[r][c+i-1] = s:sub(i,i) end
    end
  end
  local rows = {}
  for r = 1, H do rows[r] = table.concat(g[r]) end
  return rows
end

