        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Achievements</string>
            <string name="Source"><![CDATA[--!strict
-- EXOTIC Achievements screen — port of src/app/achievements/page.tsx.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local App = require(Shared:WaitForChild("App"))
local Ui = require(Shared:WaitForChild("Ui"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Achievements = {}
Achievements.__index = Achievements

local GLYPHS = {
	["first-death"] = "☠", ["first-clear"] = "⚑", ["deaths-25"] = "✕",
	["deaths-100"] = "✕", ["deaths-250"] = "✕", ["flawless"] = "★",
	["speedrun"] = "⏱", ["trio"] = "③", ["full-clear"] = "♛",
	["hoarder"] = "●", ["shopper"] = "▣",
}

function Achievements.build()
	local self = setmetatable({}, Achievements)
	local shell = Ui.shell({
		parent = App.root, name = "Achievements", title = "ACHIEVEMENTS", backLabel = "← Home",
		onBack = function() App.navigate("Home") end, theme = App.state.theme, visible = false,
	})
	self.screen = shell.screen
	self.body = shell.body

	local grid = Instance.new("Frame")
	grid.Size = UDim2.new(1, 0, 0, 0)
	grid.AutomaticSize = Enum.AutomaticSize.Y
	grid.BackgroundTransparency = 1
	grid.Parent = shell.body
	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.new(0.5, -8, 0, 92)
	gl.CellPadding = UDim2.new(0, 16, 0, 12)
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.Parent = grid
	self.grid = grid
	self.cards = {}

	for order, def in ipairs(Catalog.ACHIEVEMENTS) do
		table.insert(self.cards, self:buildCard(def, order))
	end
	return self
end

function Achievements:buildCard(def, order)
	local tok = Ui.tokens(App.state.theme)
	local card = Instance.new("Frame")
	card.BackgroundColor3 = tok.pan
	card.BorderSizePixel = 0
	card.LayoutOrder = order
	card.Parent = self.grid
	Ui.corner(card, 12)

	local icon = Instance.new("TextLabel")
	icon.Size = UDim2.new(0, 40, 0, 40)
	icon.Position = UDim2.new(0, 12, 0, 14)
	icon.BackgroundColor3 = tok.pan2
	icon.TextColor3 = tok.mut
	icon.FontFace = Ui.FONT_MONO_BOLD
	icon.TextSize = 20
	icon.Text = GLYPHS[def.key] or "★"
	icon.BorderSizePixel = 0
	icon.Parent = card
	Ui.corner(icon, 20)

	local name = Ui.label({ parent = card, text = def.name, color = tok.fg, font = Ui.FONT_MONO_BOLD, textSize = 13, size = UDim2.new(1, -72, 0, 20), xAlign = Enum.TextXAlignment.Left, order = 2 })
	name.Position = UDim2.new(0, 60, 0, 14)
	local desc = Ui.label({ parent = card, text = def.desc, color = tok.mut, font = Ui.FONT_MONO, textSize = 11, size = UDim2.new(1, -72, 0, 32), xAlign = Enum.TextXAlignment.Left, wrapped = true, order = 3 })
	desc.Position = UDim2.new(0, 60, 0, 34)
	local state = Ui.label({ parent = card, text = "LOCKED", color = tok.mut, font = Ui.FONT_MONO_BOLD, textSize = 10, size = UDim2.new(0, 80, 0, 16), xAlign = Enum.TextXAlignment.Left, order = 4 })
	state.Position = UDim2.new(0, 60, 1, -22)

	return { card = card, icon = icon, state = state, def = def }
end

function Achievements:refresh()
	local owned = App.state.achievements or {}
	local tok = Ui.tokens(App.state.theme)
	for _, c in ipairs(self.cards) do
		local ts = owned[c.def.key]
		local unlocked = ts ~= nil and ts > 0
		c.state.Text = if unlocked then "UNLOCKED" else "LOCKED"
		c.state.TextColor3 = if unlocked then tok.fg else tok.mut
		c.icon.BackgroundColor3 = if unlocked then tok.fg else tok.pan2
		c.icon.TextColor3 = if unlocked then tok.bg else tok.mut
		c.card.BackgroundTransparency = if unlocked then 0 else 0.25
	end
end

function Achievements:onEnter()
	self:refresh()
	task.spawn(function()
		local ok, res = pcall(function() return Remotes.FetchAchievements:InvokeServer() end)
		if ok and res and res.owned then
			App.state.achievements = res.owned
			self:refresh()
		end
	end)
end

function Achievements:onExit() end

return Achievements
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Credits</string>
            <string name="Source"><![CDATA[--!strict
-- EXOTIC Credits screen — port of src/app/credits/page.tsx.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local App = require(Shared:WaitForChild("App"))
local Ui = require(Shared:WaitForChild("Ui"))

local Credits = {}
Credits.__index = Credits

local ROLES = {
	{ "GAME DIRECTION", "THE EXOTIC TEAM" },
	{ "TROLL PHYSICS", "THE EXOTIC TEAM" },
	{ "TRAP ARCHITECTURE", "THE EXOTIC TEAM" },
	{ "UI & MOTION DESIGN", "THE EXOTIC TEAM" },
	{ "SOUND SYNTHESIS", "THE EXOTIC TEAM — MADE OF MATH, LIVE" },
	{ "QUALITY ASSURANCE", "FAILED ON PURPOSE" },
	{ "PLAYER EMOTIONAL SUPPORT", "NOT AVAILABLE" },
}

function Credits.build()
	local self = setmetatable({}, Credits)
	local shell = Ui.shell({
		parent = App.root, name = "Credits", title = "CREDITS", backLabel = "← Home",
		sub = "EVERY SQUARE, EVERY BETRAYAL — DESIGNED AND ENGINEERED BY HUMANS.",
		onBack = function() App.navigate("Home") end, theme = App.state.theme, visible = false,
	})
	self.screen = shell.screen
	self.body = shell.body
	local tok = Ui.tokens(App.state.theme)

	local intro = Ui.label({ parent = self.body, text = "EXOTIC was built by hand: every tile placed to be trusted once, every flag raised to be doubted forever. No asset stores, no template levels — just humans who understand exactly where you'll jump.", color = tok.fg, font = Ui.FONT_MONO, textSize = 16, size = UDim2.new(1, -40, 0, 90), wrapped = true, order = 1 })

	local roles = Instance.new("Frame")
	roles.Size = UDim2.new(1, 0, 0, 0)
	roles.AutomaticSize = Enum.AutomaticSize.Y
	roles.Position = UDim2.new(0, 0, 0, 110)
	roles.BackgroundTransparency = 1
	roles.Parent = self.body
	local rl = Instance.new("UIListLayout"); rl.Padding = UDim.new(0, 4); rl.Parent = roles
	for i, role in ipairs(ROLES) do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 40)
		row.BackgroundTransparency = 1
		row.LayoutOrder = i
		row.Parent = roles
		Ui.label({ parent = row, text = role[1], color = tok.mut, font = Ui.FONT_MONO_BOLD, textSize = 11, size = UDim2.new(0.5, 0, 1, 0), xAlign = Enum.TextXAlignment.Left })
		local who = Ui.label({ parent = row, text = role[2], color = tok.fg, font = Ui.FONT_MONO_BOLD, textSize = 12, size = UDim2.new(0.5, 0, 1, 0), xAlign = Enum.TextXAlignment.Right })
		who.Position = UDim2.new(0.5, 0, 0, 0)
	end

	-- permanent record
	local record = Instance.new("Frame")
	record.Size = UDim2.new(1, 0, 0, 140)
	record.Position = UDim2.new(0, 0, 0, 110 + #ROLES * 44 + 20)
	record.BackgroundColor3 = tok.fg
	record.BorderSizePixel = 0
	record.Parent = self.body
	Ui.corner(record, 20)
	Ui.pad(record, 24, 20, 24, 20)
	Ui.label({ parent = record, text = "YOUR PERMANENT RECORD", color = tok.bg, font = Ui.FONT_MONO_BOLD, textSize = 10, size = UDim2.new(1, 0, 0, 16), transparency = 0.4, xAlign = Enum.TextXAlignment.Left })
	local stats = Instance.new("Frame")
	stats.Size = UDim2.new(1, 0, 1, -24)
	stats.Position = UDim2.new(0, 0, 0, 24)
	stats.BackgroundTransparency = 1
	stats.Parent = record
	local sl = Instance.new("UIListLayout"); sl.FillDirection = Enum.FillDirection.Horizontal; sl.Padding = UDim.new(0, 40); sl.Parent = stats
	self.statCol = {}
	for _, def in ipairs({ { "DEATHS", "deaths" }, { "CLEARED", "cleared" }, { "COINS", "coins" } }) do
		local col = Instance.new("Frame")
		col.Size = UDim2.new(0, 100, 1, 0)
		col.AutomaticSize = Enum.AutomaticSize.X
		col.BackgroundTransparency = 1
		col.Parent = stats
		local v = Ui.label({ parent = col, text = "0", color = tok.bg, font = Ui.FONT_HEAD, textSize = 34, size = UDim2.new(0, 0, 0, 42), automatic = Enum.AutomaticSize.X, xAlign = Enum.TextXAlignment.Left })
		local l = Ui.label({ parent = col, text = def[1], color = tok.bg, font = Ui.FONT_MONO_BOLD, textSize = 10, size = UDim2.new(0, 0, 0, 14), automatic = Enum.AutomaticSize.X, transparency = 0.4, xAlign = Enum.TextXAlignment.Left })
		self.statCol[def[2]] = v
	end

	local ded = Ui.label({ parent = self.body, text = "DEDICATED TO EVERYONE WHO TRUSTED THE FLOOR.\nTHE FLOOR THANKS YOU. THE FLOOR IS GONE.", color = tok.mut, font = Ui.FONT_MONO, textSize = 12, size = UDim2.new(1, 0, 0, 40), wrapped = true, order = 10 })
	ded.Position = UDim2.new(0, 0, 0, record.Position.Y.Offset + 160)
	local copy = Ui.label({ parent = self.body, text = "© EXOTIC CO. — NO SPIKES WERE HARMED.", color = tok.mut, font = Ui.FONT_MONO_BOLD, textSize = 10, size = UDim2.new(1, 0, 0, 16), order = 11 })
	copy.Position = UDim2.new(0, 0, 0, record.Position.Y.Offset + 210)

	return self
end

function Credits:refresh()
	local profile = App.state.profile or {}
	local progress = App.state.progress or {}
	local cleared = 0
	for _, p in pairs(progress) do if p.completed then cleared += 1 end end
	self.statCol.deaths.Text = tostring(profile.totalDeaths or 0)
	self.statCol.cleared.Text = cleared .. "/6"
	self.statCol.coins.Text = tostring(App.coins())
end

function Credits:onEnter()
	self:refresh()
end

function Credits:onExit() end

return Credits
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Home</string>
            <string name="Source"><![CDATA[--!strict
-- EXOTIC Home screen — port of src/app/page.tsx (hero, numbered nav, taunt
-- ticker, player chip, theme toggle).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local App = require(Shared:WaitForChild("App"))
local Ui = require(Shared:WaitForChild("Ui"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local Audio = require(Shared:WaitForChild("Audio"))

local Home = {}
Home.__index = Home

local NAV = {
	{ key = "1", label = "PLAY", screen = "Levels", glyph = "▶" },
	{ key = "2", label = "SHOP", screen = "Shop", glyph = "▣" },
	{ key = "3", label = "LEVELS", screen = "Levels", glyph = "▤" },
	{ key = "4", label = "LEADERBOARD", screen = "Leaderboard", glyph = "▥" },
	{ key = "5", label = "ACHIEVEMENTS", screen = "Achievements", glyph = "♛" },
	{ key = "6", label = "SETTINGS", screen = "Settings", glyph = "⚙" },
	{ key = "7", label = "CREDITS", screen = "Credits", glyph = "ⓘ" },
}

function Home.build()
	local self = setmetatable({}, Home)
	local tok = Ui.tokens(App.state.theme)

	local screen = Instance.new("Frame")
	screen.Name = "Home"
	screen.Size = UDim2.new(1, 0, 1, 0)
	screen.BackgroundColor3 = tok.bg
	screen.BorderSizePixel = 0
	screen.Visible = false
	screen.Parent = App.root
	self.screen = screen

	-- top bar: brand + theme toggle + coins
	local top = Instance.new("Frame")
	top.Size = UDim2.new(1, -40, 0, 44)
	top.Position = UDim2.new(0, 20, 0, 12)
	top.BackgroundTransparency = 1
	top.Parent = screen
	local tl = Instance.new("UIListLayout"); tl.FillDirection = Enum.FillDirection.Horizontal; tl.VerticalAlignment = Enum.VerticalAlignment.Center; tl.Padding = UDim.new(0, 8); tl.Parent = top

	local brand = Instance.new("Frame"); brand.AutomaticSize = Enum.AutomaticSize.X; brand.Size = UDim2.new(0, 0, 0, 34); brand.BackgroundTransparency = 1; brand.Parent = top
	local bl = Instance.new("UIListLayout"); bl.FillDirection = Enum.FillDirection.Horizontal; bl.VerticalAlignment = Enum.VerticalAlignment.Center; bl.Padding = UDim.new(0, 6); bl.Parent = brand
	Ui.label({ parent = brand, text = "◆", color = tok.fg, font = Ui.FONT_MONO_BOLD, textSize = 20, size = UDim2.new(0, 22, 0, 24), xAlign = Enum.TextXAlignment.Center })
	Ui.label({ parent = brand, text = "EXOTIC", color = tok.fg, font = Ui.FONT_HEAD, textSize = 20, size = UDim2.new(0, 0, 1, 0), automatic = Enum.AutomaticSize.X })

	local spacer = Instance.new("Frame"); spacer.Size = UDim2.new(1, -300, 1, 0); spacer.BackgroundTransparency = 1; spacer.LayoutOrder = 50; spacer.Parent = top

	self.coinsChip, self.coinsText = Ui.chip({ parent = top, text = "● 0", theme = App.state.theme, height = 32, order = 60, textSize = 12 })
	self.themeBtn = Ui.iconButton({ parent = top, name = "Theme", text = "☾", size = 32, theme = App.state.theme, order = 70, textSize = 16, onClick = function() self:toggleTheme() end })

	-- player chip
	self.playerChip, self.playerText = Ui.chip({ parent = top, text = "PLAYER", theme = App.state.theme, height = 32, order = 65, textSize = 11 })

	-- hero
	local hero = Instance.new("Frame")
	hero.Size = UDim2.new(1, -40, 0, 200)
	hero.Position = UDim2.new(0, 20, 0, 90)
	hero.BackgroundTransparency = 1
	hero.Parent = screen
	local hl = Instance.new("UIListLayout"); hl.VerticalAlignment = Enum.VerticalAlignment.Center; hl.HorizontalAlignment = Enum.HorizontalAlignment.Left; hl.Padding = UDim.new(0, 6); hl.Parent = hero
	local kick = Ui.label({ parent = hero, text = "A MONOCHROME RAGE PLATFORMER", color = tok.mut, font = Ui.FONT_MONO, textSize = 13, size = UDim2.new(1, 0, 0, 20), order = 1 })
	local title = Ui.label({ parent = hero, text = "EXOTIC", color = tok.fg, font = Ui.FONT_HEAD, textSize = 72, size = UDim2.new(1, 0, 0, 88), order = 2 })
	local sub = Ui.label({ parent = hero, text = "Invisible traps. Fake flags. Bomb crates. Everything lies.", color = tok.mut, font = Ui.FONT_MONO, textSize = 14, size = UDim2.new(1, 0, 0, 22), order = 3 })

	-- nav list
	local nav = Instance.new("Frame")
	nav.Size = UDim2.new(1, -40, 0, 340)
	nav.Position = UDim2.new(0, 20, 0, 300)
	nav.BackgroundTransparency = 1
	nav.Parent = screen
	local nl = Instance.new("UIListLayout"); nl.Padding = UDim.new(0, 8); nl.Parent = nav
	self.navButtons = {}
	for i, item in ipairs(NAV) do
		local b = self:navRow(nav, item, i)
		table.insert(self.navButtons, { btn = b, screen = item.screen })
	end

	-- taunt ticker
	local ticker = Instance.new("TextLabel")
	ticker.Size = UDim2.new(1, -40, 0, 24)
	ticker.Position = UDim2.new(0, 20, 1, -34)
	ticker.BackgroundTransparency = 1
	ticker.TextColor3 = tok.mut
	ticker.FontFace = Ui.FONT_MONO
	ticker.TextSize = 12
	ticker.TextXAlignment = Enum.TextXAlignment.Left
	ticker.Text = ""
	ticker.Name = "Ticker"
	ticker.Parent = screen
	self.ticker = ticker
	self.tickerIndex = 1
	self.tickerThread = task.spawn(function()
		local all = {}
		for _, pack in pairs(Catalog.TAUNTS) do for _, t in ipairs(pack) do table.insert(all, t) end end
		while true do
			ticker.Text = "“ " .. all[(self.tickerIndex % #all) + 1] .. " ”"
			self.tickerIndex += 1
			task.wait(2.4)
		end
	end)

	-- hotkeys
	self.keyConn = game:GetService("UserInputService").InputBegan:Connect(function(input, gp)
		if gp or not screen.Visible then return end
		local n = nil
		if input.KeyCode == Enum.KeyCode.One then n = 1
		elseif input.KeyCode == Enum.KeyCode.Two then n = 2
		elseif input.KeyCode == Enum.KeyCode.Three then n = 3
		elseif input.KeyCode == Enum.KeyCode.Four then n = 4
		elseif input.KeyCode == Enum.KeyCode.Five then n = 5
		elseif input.KeyCode == Enum.KeyCode.Six then n = 6
		elseif input.KeyCode == Enum.KeyCode.Seven then n = 7 end
		if n and NAV[n] then Audio.sfx.nav(); App.navigate(NAV[n].screen) end
	end)

	return self
end

function Home:navRow(parent, item, order)
	local tok = Ui.tokens(App.state.theme)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.Size = UDim2.new(1, 0, 0, 44)
	b.BackgroundColor3 = tok.pan
	b.TextColor3 = tok.fg
	b.BorderSizePixel = 0
	b.LayoutOrder = order
	Ui.corner(b, 12)
	b.Parent = parent
	local row = Instance.new("Frame"); row.Size = UDim2.new(1, -24, 1, 0); row.Position = UDim2.new(0, 16, 0, 0); row.BackgroundTransparency = 1; row.Parent = b
	local rl = Instance.new("UIListLayout"); rl.FillDirection = Enum.FillDirection.Horizontal; rl.VerticalAlignment = Enum.VerticalAlignment.Center; rl.Padding = UDim.new(0, 12); rl.Parent = row
	Ui.label({ parent = row, text = item.key, color = tok.mut, font = Ui.FONT_MONO_BOLD, textSize = 14, size = UDim2.new(0, 18, 0, 24), xAlign = Enum.TextXAlignment.Center })
	Ui.label({ parent = row, text = item.glyph, color = tok.fg, font = Ui.FONT_MONO_BOLD, textSize = 18, size = UDim2.new(0, 24, 0, 24), xAlign = Enum.TextXAlignment.Center })
	Ui.label({ parent = row, text = item.label, color = tok.fg, font = Ui.FONT_MONO_BOLD, textSize = 16, size = UDim2.new(0, 0, 1, 0), automatic = Enum.AutomaticSize.X })
	b.MouseEnter:Connect(function() Audio.sfx.hover() end)
	b.MouseButton1Click:Connect(function()
		Audio.sfx.nav()
		App.navigate(item.screen)
	end)
	return b
end

function Home:toggleTheme()
	local nextTheme = if App.state.theme == "dark" then "light" else "dark"
	Audio.sfx.toggle()
	task.spawn(function()
		pcall(function()
			require(Shared:WaitForChild("Remotes")).PatchSettings:InvokeServer({ theme = nextTheme })
		end)
		App.setTheme(nextTheme)
	end)
end

function Home:refresh()
	self.coinsText.Text = string.format("● %d", App.coins())
	local acct = App.state.account
	self.playerText.Text = if acct then string.upper(acct.username or "PLAYER") else "PLAYER"
	self.themeBtn.Text = if App.state.theme == "dark" then "☾" else "☀"
end

function Home:onEnter()
	self:refresh()
end

function Home:onExit() end

return Home
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Leaderboard</string>
            <string name="Source"><![CDATA[--!strict
-- EXOTIC Leaderboard screen — port of src/app/leaderboard/page.tsx. Three
-- tabs (most cleared / fewest deaths / fastest), fetched from the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local App = require(Shared:WaitForChild("App"))
local Ui = require(Shared:WaitForChild("Ui"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Utils = require(Shared:WaitForChild("Utils"))
local Audio = require(Shared:WaitForChild("Audio"))

local Leaderboard = {}
Leaderboard.__index = Leaderboard

local TABS = {
	{ key = "cleared", label = "MOST CLEARED", fmt = function(v) return tostring(v) end },
	{ key = "deaths", label = "FEWEST DEATHS", fmt = function(v) return tostring(v) end },
	{ key = "speed", label = "FASTEST", fmt = function(v) return Utils.fmtTime(v) end },
}

function Leaderboard.build()
	local self = setmetatable({}, Leaderboard)
	local shell = Ui.shell({
		parent = App.root, name = "Leaderboard", title = "LEADERBOARD", backLabel = "← Home",
		onBack = function() App.navigate("Home") end, theme = App.state.theme, visible = false,
	})
	self.screen = shell.screen
	self.body = shell.body
	self.active = "cleared"
	self.data = {}

	local tabs = Instance.new("Frame")
	tabs.Size = UDim2.new(1, 0, 0, 38)
	tabs.BackgroundTransparency = 1
	tabs.Parent = shell.body
	local tl = Instance.new("UIListLayout"); tl.FillDirection = Enum.FillDirection.Horizontal; tl.Padding = UDim.new(0, 8); tl.Parent = tabs
	self.tabBtns = {}
	for _, tab in ipairs(TABS) do
		local b = Ui.pill({ parent = tabs, label = tab.label, variant = "soft", size = "sm", theme = App.state.theme, order = #self.tabBtns + 1, onClick = function() self:setTab(tab.key) end })
		table.insert(self.tabBtns, { btn = b, key = tab.key })
	end

	local list = Instance.new("Frame")
	list.Size = UDim2.new(1, 0, 0, 0)
	list.AutomaticSize = Enum.AutomaticSize.Y
	list.Position = UDim2.new(0, 0, 0, 48)
	list.BackgroundTransparency = 1
	list.Parent = shell.body
	local ll = Instance.new("UIListLayout"); ll.Padding = UDim.new(0, 6); ll.Parent = list
	self.list = list
	return self
end

function Leaderboard:setTab(key)
	self.active = key
	self:render()
end

function Leaderboard:fetch()
	task.spawn(function()
		local ok, res = pcall(function() return Remotes.FetchLeaderboard:InvokeServer(25) end)
		if ok and res then
			self.data = res
			self:render()
		end
	end)
end

function Leaderboard:render()
	for _, c in ipairs(self.list:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	local tok = Ui.tokens(App.state.theme)
	local tabDef = nil
	for _, t in ipairs(TABS) do if t.key == self.active then tabDef = t end end
	local rows = self.data[self.active] or {}
	if #rows == 0 then
		Ui.label({ parent = self.list, text = "NO RUNS YET. BE THE FIRST TO SUFFER.", color = tok.mut, font = Ui.FONT_MONO, textSize = 13, size = UDim2.new(1, 0, 0, 40), xAlign = Enum.TextXAlignment.Left })
		return
	end
	for order, row in ipairs(rows) do
		local entry = Instance.new("Frame")
		entry.Size = UDim2.new(1, 0, 0, 40)
		entry.BackgroundColor3 = tok.pan
		entry.BorderSizePixel = 0
		entry.LayoutOrder = order
		entry.Parent = self.list
		Ui.corner(entry, 10)
		Ui.label({ parent = entry, text = "#" .. row.rank, color = tok.mut, font = Ui.FONT_MONO_BOLD, textSize = 13, size = UDim2.new(0, 40, 1, 0), xAlign = Enum.TextXAlignment.Left }).Position = UDim2.new(0, 12, 0, 0)
		Ui.label({ parent = entry, text = row.name, color = tok.fg, font = Ui.FONT_MONO_BOLD, textSize = 13, size = UDim2.new(1, -180, 1, 0), xAlign = Enum.TextXAlignment.Left }).Position = UDim2.new(0, 56, 0, 0)
		local v = Ui.label({ parent = entry, text = tabDef.fmt(row.value), color = tok.fg, font = Ui.FONT_MONO_BOLD, textSize = 14, size = UDim2.new(0, 120, 1, 0), xAlign = Enum.TextXAlignment.Right })
		v.Position = UDim2.new(1, -140, 0, 0)
	end
end

function Leaderboard:onEnter()
	self:render()
	self:fetch()
end

function Leaderboard:onExit() end

return Leaderboard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Levels</string>
            <string name="Source"><![CDATA[--!strict
-- EXOTIC Levels screen — port of src/app/levels/page.tsx. Level cards with
-- live bot previews, cleared/locked state, par times and skip-token unlock.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local App = require(Shared:WaitForChild("App"))
local Ui = require(Shared:WaitForChild("Ui"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local Levels = require(Shared:WaitForChild("Levels"))
local Preview = require(Shared:WaitForChild("Preview"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Audio = require(Shared:WaitForChild("Audio"))

local LevelsScreen = {}
LevelsScreen.__index = LevelsScreen

function LevelsScreen.build()
	local self = setmetatable({}, LevelsScreen)
	local shell = Ui.shell({
		parent = App.root, name = "Levels", title = "LEVELS", backLabel = "← Home",
		onBack = function() App.navigate("Home") end, theme = App.state.theme, visible = false,
	})
	self.screen = shell.screen
	self.body = shell.body
	self.shell = shell
	self.cards = {}

	local grid = Instance.new("Frame")
	grid.Size = UDim2.new(1, 0, 0, 0)
	grid.AutomaticSize = Enum.AutomaticSize.Y
	grid.BackgroundTransparency = 1
	grid.Parent = shell.body
	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.new(0.5, -8, 0, 220)
	gl.CellPadding = UDim2.new(0, 16, 0, 16)
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.Parent = grid
	self.grid = grid

	for i = 1, #Catalog.LEVEL_META do
		table.insert(self.cards, self:buildCard(grid, i))
	end
	return self
end

function LevelsScreen:buildCard(parent, index)
	local meta = Catalog.LEVEL_META[index]
	local tok = Ui.tokens(App.state.theme)

	local card = Instance.new("Frame")
	card.BackgroundColor3 = tok.pan
	card.BorderSizePixel = 0
	card.LayoutOrder = index
	card.Parent = parent
	Ui.corner(card, 16)

	-- preview stage
	local previewHolder = Instance.new("Frame")
	previewHolder.Size = UDim2.new(1, -16, 0, 120)
	previewHolder.Position = UDim2.new(0, 8, 0, 8)
	previewHolder.BackgroundColor3 = Color3.fromHex(if App.state.theme == "dark" then "0b0b0c" else "f1f1ee")
	previewHolder.BorderSizePixel = 0
	previewHolder.ClipsDescendants = true
	previewHolder.Parent = card
	Ui.corner(previewHolder, 10)

	local overlay = Instance.new("Frame")
	overlay.Size = UDim2.new(1, 0, 1, 0)
	overlay.BackgroundColor3 = Color3.new(0, 0, 0)
	overlay.BackgroundTransparency = 0.4
	overlay.Visible = false
	overlay.ZIndex = 5
	overlay.Parent = previewHolder
	Ui.corner(overlay, 10)
	local lockIcon = Ui.label({ parent = overlay, text = "🔒", color = Color3.fromHex("fafafa"), font = Ui.FONT_MONO_BOLD, textSize = 28, size = UDim2.new(1, 0, 1, 0), xAlign = Enum.TextXAlignment.Center })
	lockIcon.ZIndex = 6
	self.overlayFor = self.overlayFor or {}
	self.overlayFor[index] = overlay

	local clearedTag = Instance.new("TextLabel")
	clearedTag.Size = UDim2.new(0, 10, 0, 22)
	clearedTag.AutomaticSize = Enum.AutomaticSize.X
	clearedTag.Position = UDim2.new(1, -8, 0, 8)
	clearedTag.AnchorPoint = Vector2.new(1, 0)
	clearedTag.BackgroundColor3 = tok.fg
	clearedTag.TextColor3 = tok.bg
	clearedTag.FontFace = Ui.FONT_MONO_BOLD
	clearedTag.TextSize = 10
	clearedTag.Text = "✓ CLEARED"
	clearedTag.ZIndex = 6
	clearedTag.BorderSizePixel = 0
	clearedTag.Visible = false
	clearedTag.Parent = previewHolder
	Ui.corner(clearedTag, 11)
	Ui.pad(clearedTag, 10, 0, 10, 0)
	self.clearedFor = self.clearedFor or {}
	self.clearedFor[index] = clearedTag

	local openTag = Instance.new("TextLabel")
	openTag.Size = UDim2.new(0, 10, 0, 22)
	openTag.AutomaticSize = Enum.AutomaticSize.X
	openTag.Position = UDim2.new(1, -8, 0, 8)
	openTag.AnchorPoint = Vector2.new(1, 0)
	openTag.BackgroundColor3 = tok.bg
	openTag.TextColor3 = tok.fg
	openTag.FontFace = Ui.FONT_MONO_BOLD
	openTag.TextSize = 10
	openTag.Text = "▶ OPEN"
	openTag.ZIndex = 6
	openTag.BorderSizePixel = 0
	openTag.Visible = false
	openTag.Parent = previewHolder
	Ui.corner(openTag, 11)
	Ui.pad(openTag, 10, 0, 10, 0)
	self.openFor = self.openFor or {}
	self.openFor[index] = openTag

	-- text + play button
	Ui.label({ parent = card, text = meta.name, color = tok.fg, font = Ui.FONT_HEAD, textSize = 18, size = UDim2.new(1, -16, 0, 24), order = 2 }).Position = UDim2.new(0, 8, 0, 136)
	Ui.label({ parent = card, text = meta.sub, color = tok.mut, font = Ui.FONT_MONO, textSize = 12, size = UDim2.new(1, -16, 0, 18), order = 3 }).Position = UDim2.new(0, 8, 0, 160)
	Ui.label({ parent = card, text = string.format("PAR %ds · DEATHLESS +%d", meta.par, meta.deathlessBonus), color = tok.mut, font = Ui.FONT_MONO_BOLD, textSize = 10, size = UDim2.new(1, -16, 0, 16), order = 4 }).Position = UDim2.new(0, 8, 0, 180)

	local play = Ui.pill({ parent = card, label = "▶ PLAY", variant = "solid", size = "sm", theme = App.state.theme, width = 110, order = 5, onClick = function() self:play(index) end })
	play.Position = UDim2.new(1, -8, 0, 178)
	play.AnchorPoint = Vector2.new(1, 0)

	local skip = Ui.pill({ parent = card, label = "⏩ SKIP", variant = "soft", size = "sm", theme = App.state.theme, width = 90, order = 6, onClick = function() self:useSkip(index) end })
	skip.Position = UDim2.new(1, -124, 0, 178)
	skip.AnchorPoint = Vector2.new(1, 0)
	self.skipFor = self.skipFor or {}
	self.skipFor[index] = skip

	return { card = card, previewHolder = previewHolder, player = nil, index = index }
end

function LevelsScreen:play(index)
	Audio.sfx.select()
	App.navigate("Play", index)
end

function LevelsScreen:useSkip(index)
	task.spawn(function()
		local ok, res = pcall(function() return Remotes.UseItem:InvokeServer({ itemId = "gear:skip" }) end)
		if ok and res and res.ok then
			if res.profile then App.state.profile = res.profile end
			if res.unlockedLevel then App.state.unlockedLevel = res.unlockedLevel end
			Audio.sfx.buy()
			App.notify("LEVEL UNLOCKED", "THE SUFFERING EXTENDS", "silent")
			self:refresh()
		else
			App.notify("NO SKIP TOKEN", "THE SHOP SELLS THEM", "error")
		end
	end)
end

function LevelsScreen:refresh()
	local unlocked = App.state.unlockedLevel or 1
	local progress = App.state.progress or {}
	for _, card in ipairs(self.cards) do
		local index = card.index
		local locked = index > unlocked
		local prog = progress[tostring(index)] or progress[index]
		local cleared = prog ~= nil and prog.completed == true
		if self.overlayFor[index] then self.overlayFor[index].Visible = locked end
		if self.clearedFor[index] then self.clearedFor[index].Visible = cleared end
		if self.openFor[index] then self.openFor[index].Visible = (not locked) and (not cleared) end
		if self.skipFor[index] then
			-- web only offers skip on the single next-locked level (m.id === unlockedLevel + 1)
			self.skipFor[index].Visible = locked and index == unlocked + 1 and App.ownedQty("gear:skip") > 0
		end
	end
end

function LevelsScreen:startPreviews()
	for _, card in ipairs(self.cards) do
		local spec = Preview.Preview.levelPreviewSpec(card.index)
		if spec then
			card.player = Preview.PreviewPlayer.new(card.previewHolder, spec, App.state.theme, 380, 130)
		end
	end
end

function LevelsScreen:onEnter()
	self:refresh()
	if not self.previewsStarted then
		self.previewsStarted = true
		task.spawn(function() self:startPreviews() end)
	else
		for _, card in ipairs(self.cards) do
			if card.player then card.player:setPalette(App.state.theme) end
		end
	end
end

function LevelsScreen:onExit()
	-- keep previews running cheaply paused by hiding; destroy to save perf
	for _, card in ipairs(self.cards) do
		if card.player then card.player:destroy(); card.player = nil end
	end
	self.previewsStarted = false
end

return LevelsScreen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Locked</string>
            <string name="Source"><![CDATA[--!strict
-- EXOTIC Locked screen — shown when a level is locked (port of the locked
-- branch in src/components/game-screen.tsx).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local App = require(Shared:WaitForChild("App"))
local Ui = require(Shared:WaitForChild("Ui"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Audio = require(Shared:WaitForChild("Audio"))

local Locked = {}
Locked.__index = Locked

function Locked.build()
	local self = setmetatable({}, Locked)
	local tok = Ui.tokens(App.state.theme)
	local screen = Instance.new("Frame")
	screen.Name = "Locked"
	screen.Size = UDim2.new(1, 0, 1, 0)
	screen.BackgroundColor3 = tok.bg
	screen.BorderSizePixel = 0
	screen.Visible = false
	screen.Parent = App.root
	self.screen = screen

	local col = Instance.new("UIListLayout")
	col.VerticalAlignment = Enum.VerticalAlignment.Center
	col.HorizontalAlignment = Enum.HorizontalAlignment.Center
	col.Padding = UDim.new(0, 14)
	col.Parent = screen

	local badge = Instance.new("TextLabel")
	badge.Size = UDim2.new(0, 80, 0, 80)
	badge.BackgroundColor3 = tok.fg
	badge.TextColor3 = tok.bg
	badge.Text = "🔒"
	badge.FontFace = Ui.FONT_MONO_BOLD
	badge.TextSize = 34
	badge.BorderSizePixel = 0
	badge.LayoutOrder = 1
	badge.Parent = screen
	Ui.corner(badge, 40)

	self.title = Ui.label({ parent = screen, text = "LOCKED.", color = tok.fg, font = Ui.FONT_HEAD, textSize = 48, size = UDim2.new(0, 400, 0, 60), xAlign = Enum.TextXAlignment.Center, order = 2 })
	self.sub = Ui.label({ parent = screen, text = "", color = tok.mut, font = Ui.FONT_MONO, textSize = 12, size = UDim2.new(0, 480, 0, 20), xAlign = Enum.TextXAlignment.Center, order = 3 })

	local row = Instance.new("Frame")
	row.AutomaticSize = Enum.AutomaticSize.X
	row.Size = UDim2.new(0, 0, 0, 46)
	row.BackgroundTransparency = 1
	row.LayoutOrder = 4
	row.Parent = screen
	local rl = Instance.new("UIListLayout"); rl.FillDirection = Enum.FillDirection.Horizontal; rl.Padding = UDim.new(0, 10); rl.Parent = row
	Ui.pill({ parent = row, label = "← Level Select", variant = "solid", theme = App.state.theme, onClick = function() App.navigate("Levels") end })
	self.skipBtn = Ui.pill({ parent = row, label = "⏩ Use Skip Token", variant = "soft", theme = App.state.theme, onClick = function() self:useSkip() end })

	return self
end

function Locked:useSkip()
	task.spawn(function()
		local ok, res = pcall(function() return Remotes.UseItem:InvokeServer({ itemId = "gear:skip" }) end)
		if ok and res and res.ok then
			if res.profile then App.state.profile = res.profile end
			if res.unlockedLevel then App.state.unlockedLevel = res.unlockedLevel end
			Audio.sfx.buy()
			App.notify("LEVEL UNLOCKED", "THE SUFFERING EXTENDS", "silent")
			if self.levelId then App.navigate("Play", self.levelId) end
		else
			App.notify("NO SKIP TOKEN", "THE SHOP SELLS THEM", "error")
		end
	end)
end

function Locked:onEnter(levelId)
	self.levelId = levelId or 1
	self.sub.Text = string.format("CLEAR LEVEL %d FIRST. OR PAY TO SKIP.", math.max(1, (App.state.unlockedLevel or 1) - 1))
	self.skipBtn.Visible = App.ownedQty("gear:skip") > 0
end

function Locked:onExit() end

return Locked
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Play</string>
            <string name="Source"><![CDATA[--!strict
-- EXOTIC Play screen — a faithful port of src/components/game-screen.tsx.
-- Owns the Engine + Renderer, the HUD, overlays, gear, controls and run sync.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Engine = require(Shared:WaitForChild("Engine"))
local Renderer = require(Shared:WaitForChild("Renderer"))
local Levels = require(Shared:WaitForChild("Levels"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local App = require(Shared:WaitForChild("App"))
local Ui = require(Shared:WaitForChild("Ui"))
local Audio = require(Shared:WaitForChild("Audio"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Utils = require(Shared:WaitForChild("Utils"))

local player = Players.LocalPlayer

local TILE = 32
local VIEW_W, VIEW_H = 960, 540

local Play = {}
Play.__index = Play

function Play.build()
	local self = setmetatable({}, Play)
	local tok = Ui.tokens(App.state.theme)

	-- outer screen frame (fills viewport), centers a scaled stage
	local screen = Instance.new("Frame")
	screen.Name = "Play"
	screen.Size = UDim2.new(1, 0, 1, 0)
	screen.BackgroundColor3 = tok.bg
	screen.BorderSizePixel = 0
	screen.Visible = false
	screen.Parent = App.root
	self.screen = screen
	self.tok = tok

	-- top bar
	local topBar = Instance.new("Frame")
	topBar.Size = UDim2.new(1, -32, 0, 44)
	topBar.Position = UDim2.new(0, 16, 0, 10)
	topBar.BackgroundTransparency = 1
	topBar.Parent = screen
	local tl = Instance.new("UIListLayout"); tl.FillDirection = Enum.FillDirection.Horizontal; tl.VerticalAlignment = Enum.VerticalAlignment.Center; tl.Padding = UDim.new(0, 8); tl.Parent = topBar
	local tr = Instance.new("UIListLayout"); tr.FillDirection = Enum.FillDirection.Horizontal; tr.HorizontalAlignment = Enum.HorizontalAlignment.Right; tr.VerticalAlignment = Enum.VerticalAlignment.Center; tr.Padding = UDim.new(0, 8); tr.Parent = topBar

	self.quitBtn = Ui.pill({ parent = topBar, label = "← Quit", variant = "ghost", size = "sm", theme = App.state.theme, width = 100, order = 1, onClick = function() self:quit() end })
	self.levelChip, self.levelText = Ui.chip({ parent = topBar, text = "LV 01", theme = App.state.theme, order = 2, height = 34, textSize = 11 })

	local rightCluster = Instance.new("Frame")
	rightCluster.Size = UDim2.new(0, 10, 0, 34)
	rightCluster.AutomaticSize = Enum.AutomaticSize.X
	rightCluster.BackgroundTransparency = 1
	rightCluster.Parent = topBar
	local rcl = Instance.new("UIListLayout"); rcl.FillDirection = Enum.FillDirection.Horizontal; rcl.Padding = UDim.new(0, 8); rcl.Parent = rightCluster
	self.timeChip, self.timeText = Ui.chip({ parent = rightCluster, text = "00:00", theme = App.state.theme, height = 34, width = 90, textSize = 12 })
	self.timeChip.Size = UDim2.new(0, 90, 0, 34)
	self.deathsChip, self.deathsText = Ui.chip({ parent = rightCluster, text = "☠ 0", theme = App.state.theme, height = 34, textSize = 12 })
	self.coinsChip, self.coinsText = Ui.chip({ parent = rightCluster, text = "● 0", theme = App.state.theme, height = 34, textSize = 12 })
	self.pauseBtn = Ui.iconButton({ parent = rightCluster, name = "Pause", text = "❚❚", size = 34, theme = App.state.theme, onClick = function() self:togglePause() end })

	-- stage container (aspect-locked, centered)
	local stageWrap = Instance.new("Frame")
	stageWrap.Size = UDim2.new(1, -32, 1, -120)
	stageWrap.Position = UDim2.new(0, 16, 0, 60)
	stageWrap.BackgroundTransparency = 1
	stageWrap.Parent = screen
	local center = Instance.new("UIAspectRatioConstraint")
	center.AspectRatio = VIEW_W / VIEW_H
	center.AspectType = Enum.AspectType.ScaleWithParentSize
	center.DominantAxis = Enum.DominantAxis.Width
	center.Parent = stageWrap
	local align = Instance.new("UIListLayout")
	align.HorizontalAlignment = Enum.HorizontalAlignment.Center
	align.VerticalAlignment = Enum.VerticalAlignment.Center
	align.Parent = stageWrap

	local stage = Instance.new("Frame")
	stage.Name = "Stage"
	stage.Size = UDim2.new(0, VIEW_W, 0, VIEW_H)
	stage.BackgroundColor3 = tok.bg
	stage.BorderSizePixel = 0
	stage.ClipsDescendants = true
	stage.Parent = stageWrap
	self.stage = stage

	self.renderer = Renderer.new(stage)

	-- toast label (over canvas)
	self.toast = Instance.new("TextLabel")
	self.toast.Size = UDim2.new(0, 10, 0, 40)
	self.toast.AutomaticSize = Enum.AutomaticSize.X
	self.toast.Position = UDim2.new(0.5, 0, 0.12, 0)
	self.toast.AnchorPoint = Vector2.new(0.5, 0)
	self.toast.BackgroundColor3 = tok.fg
	self.toast.TextColor3 = tok.bg
	self.toast.FontFace = Ui.FONT_MONO_BOLD
	self.toast.TextSize = 15
	self.toast.Text = ""
	self.toast.Visible = false
	self.toast.BorderSizePixel = 0
	self.toast.Parent = stage
	Ui.corner(self.toast, 20)
	Ui.pad(self.toast, 24, 0, 24, 0)

	-- reversed indicator
	self.reversed = Instance.new("TextLabel")
	self.reversed.Size = UDim2.new(0, 10, 0, 32)
	self.reversed.AutomaticSize = Enum.AutomaticSize.X
	self.reversed.Position = UDim2.new(0, 16, 0, 12)
	self.reversed.BackgroundColor3 = tok.fg
	self.reversed.TextColor3 = tok.bg
	self.reversed.FontFace = Ui.FONT_MONO_BOLD
	self.reversed.TextSize = 11
	self.reversed.Text = "CONTROLS REVERSED"
	self.reversed.Visible = false
	self.reversed.BorderSizePixel = 0
	self.reversed.Parent = stage
	Ui.corner(self.reversed, 16)
	Ui.pad(self.reversed, 16, 0, 16, 0)

	-- gear chips (bottom-right)
	local gear = Instance.new("Frame")
	gear.Size = UDim2.new(0, 10, 0, 36)
	gear.AutomaticSize = Enum.AutomaticSize.X
	gear.Position = UDim2.new(1, -12, 1, -12)
	gear.AnchorPoint = Vector2.new(1, 1)
	gear.BackgroundTransparency = 1
	gear.Parent = stage
	local gl = Instance.new("UIListLayout"); gl.FillDirection = Enum.FillDirection.Horizontal; gl.Padding = UDim.new(0, 8); gl.Parent = gear
	self.scopeBtn = self:gearChip(gear, "✛", "SCOPE", "gear:reveal", function() self:useReveal() end)
	self.anchorBtn = self:gearChip(gear, "⚑", "ANCHOR", "gear:pass", function() self:useAnchor() end)

	-- controls hint
	local hint = Instance.new("TextLabel")
	hint.Size = UDim2.new(0, 10, 0, 16)
	hint.AutomaticSize = Enum.AutomaticSize.X
	hint.Position = UDim2.new(0, 16, 1, -34)
	hint.BackgroundTransparency = 1
	hint.Text = "WASD/ARROWS MOVE · SPACE JUMP · R RESTART · 1 SCOPE · 2 ANCHOR · ESC PAUSE"
	hint.TextColor3 = tok.mut
	hint.FontFace = Ui.FONT_MONO
	hint.TextSize = 10
	hint.TextXAlignment = Enum.TextXAlignment.Left
	hint.Parent = stage

	-- touch controls
	self.touch = Instance.new("Frame")
	self.touch.Size = UDim2.new(1, -24, 0, 72)
	self.touch.Position = UDim2.new(0, 12, 1, -84)
	self.touch.BackgroundTransparency = 1
	self.touch.Visible = false
	self.touch.Parent = stage
	self:buildTouch(self.touch)

	-- overlays
	self.intro = self:buildIntro()
	self.pauseOv = self:buildPause()
	self.winOv = self:buildWin()

	-- bottom strip
	local bottom = Instance.new("Frame")
	bottom.Size = UDim2.new(1, -32, 0, 24)
	bottom.Position = UDim2.new(0, 16, 1, -30)
	bottom.BackgroundTransparency = 1
	bottom.Parent = screen
	self.parLabel = Ui.label({ parent = bottom, text = "", color = tok.mut, font = Ui.FONT_MONO, textSize = 11, size = UDim2.new(1, -200, 1, 0), xAlign = Enum.TextXAlignment.Left })
	local chipHolder = Instance.new("Frame")
	chipHolder.Size = UDim2.new(0, 10, 0, 24)
	chipHolder.AutomaticSize = Enum.AutomaticSize.X
	chipHolder.Position = UDim2.new(1, 0, 0, 0)
	chipHolder.AnchorPoint = Vector2.new(1, 0)
	chipHolder.BackgroundTransparency = 1
	bottom.Parent = screen
	chipHolder.Parent = bottom
	Ui.label({ parent = chipHolder, text = "", color = tok.mut, font = Ui.FONT_MONO_BOLD, textSize = 11, size = UDim2.new(0, 0, 1, 0), automatic = Enum.AutomaticSize.X, name = "Coins", xAlign = Enum.TextXAlignment.Right })

	-- state
	self.eng = nil
	self.levelId = 1
	self.running = false
	self.submitted = false
	self.winInfo = nil
	self.paused = false
	self.introOn = true
	self.lastTs = os.clock()
	self.hudConn = nil
	self.inputConn = {}
	self.toastTimer = nil

	self:bindInput()
	return self
end

function Play:gearChip(parent, glyph, label, itemId, onClick)
	local tok = Ui.tokens(App.state.theme)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.Size = UDim2.new(0, 10, 0, 34)
	b.AutomaticSize = Enum.AutomaticSize.X
	b.BackgroundColor3 = Color3.fromHex(App.state.theme == "dark" and "0b0b0c" or "f1f1ee")
	b.BackgroundTransparency = 0.15
	b.TextColor3 = tok.fg
	b.FontFace = Ui.FONT_MONO_BOLD
	b.TextSize = 10
	b.BorderSizePixel = 0
	Ui.corner(b, 18)
	Ui.pad(b, 14, 0, 14, 0)
	b.Parent = parent
	self:refreshGearLabel(b, glyph, label, itemId)
	b.MouseButton1Click:Connect(function()
		Audio.sfx.click()
		onClick()
	end)
	return b
end

function Play:refreshGearLabel(button, glyph, label, itemId)
	button.Text = string.format("%s  %s ×%d", glyph, label, App.ownedQty(itemId))
end

function Play:buildTouch(parent)
	local function roundBtn(text, wide)
		local b = Instance.new("TextButton")
		b.AutoButtonColor = false
		b.Size = if wide then UDim2.new(0, 120, 0, 64) else UDim2.new(0, 64, 0, 64)
		b.BackgroundColor3 = Color3.fromHex(App.state.theme == "dark" and "0b0b0c" or "f1f1ee")
		b.BackgroundTransparency = 0.3
		b.TextColor3 = Ui.tokens(App.state.theme).fg
		b.Text = text
		b.FontFace = Ui.FONT_MONO_BOLD
		b.TextSize = if wide then 14 else 26
		b.BorderSizePixel = 0
		Ui.corner(b, 32)
		b.Parent = parent
		return b
	end
	local left = roundBtn("‹")
	left.Position = UDim2.new(0, 0, 0.5, -32)
	local right = roundBtn("›")
	right.Position = UDim2.new(0, 72, 0.5, -32)
	local jump = roundBtn("JUMP", true)
	jump.Position = UDim2.new(1, -120, 0.5, -32)

	local function bindHold(b, code)
		b.MouseButton1Down:Connect(function() self:press(code, true) end)
		b.MouseButton1Up:Connect(function() self:press(code, false) end)
		b.MouseLeave:Connect(function() self:press(code, false) end)
	end
	bindHold(left, "ArrowLeft")
	bindHold(right, "ArrowRight")
	bindHold(jump, "Space")
end

function Play:buildIntro()
	local tok = Ui.tokens(App.state.theme)
	local ov = Instance.new("Frame")
	ov.Size = UDim2.new(1, 0, 1, 0)
	ov.BackgroundColor3 = tok.bg
	ov.BackgroundTransparency = 0.05
	ov.ZIndex = 20
	ov.Visible = false
	ov.Parent = self.stage
	local col = Instance.new("UIListLayout"); col.VerticalAlignment = Enum.VerticalAlignment.Center; col.HorizontalAlignment = Enum.HorizontalAlignment.Center; col.Padding = UDim.new(0, 8); col.Parent = ov
	self.introLevel = Ui.label({ parent = ov, text = "LEVEL 01", color = tok.mut, font = Ui.FONT_MONO, textSize = 12, xAlign = Enum.TextXAlignment.Center, size = UDim2.new(1, 0, 0, 16), order = 1 })
	self.introLevel.TextXAlignment = Enum.TextXAlignment.Center
	self.introName = Ui.label({ parent = ov, text = "", color = tok.fg, font = Ui.FONT_HEAD, textSize = 42, xAlign = Enum.TextXAlignment.Center, size = UDim2.new(1, 0, 0, 52), order = 2 })
	self.introName.TextXAlignment = Enum.TextXAlignment.Center
	self.introTip = Ui.label({ parent = ov, text = "", color = tok.mut, font = Ui.FONT_MONO, textSize = 12, xAlign = Enum.TextXAlignment.Center, size = UDim2.new(1, -40, 0, 20), order = 3 })
	self.introTip.TextXAlignment = Enum.TextXAlignment.Center
	local ready = Ui.label({ parent = ov, text = "GET READY", color = tok.fg, font = Ui.FONT_MONO_BOLD, textSize = 11, xAlign = Enum.TextXAlignment.Center, size = UDim2.new(1, 0, 0, 18), order = 4 })
	ready.TextXAlignment = Enum.TextXAlignment.Center
	return ov
end

function Play:buildPause()
	local tok = Ui.tokens(App.state.theme)
	local ov = Instance.new("Frame")
	ov.Size = UDim2.new(1, 0, 1, 0)
	ov.BackgroundColor3 = tok.bg
	ov.BackgroundTransparency = 0.1
	ov.ZIndex = 20
	ov.Visible = false
	ov.Parent = self.stage
	local col = Instance.new("UIListLayout"); col.VerticalAlignment = Enum.VerticalAlignment.Center; col.HorizontalAlignment = Enum.HorizontalAlignment.Center; col.Padding = UDim.new(0, 10); col.Parent = ov
	local h = Ui.label({ parent = ov, text = "PAUSED.", color = tok.fg, font = Ui.FONT_HEAD, textSize = 48, size = UDim2.new(1, 0, 0, 60), order = 1 })
	h.TextXAlignment = Enum.TextXAlignment.Center
	local s = Ui.label({ parent = ov, text = "THE SPIKES ARE RESTING. ENJOY IT.", color = tok.mut, font = Ui.FONT_MONO, textSize = 12, size = UDim2.new(1, 0, 0, 18), order = 2 })
	s.TextXAlignment = Enum.TextXAlignment.Center

	local row = Instance.new("Frame"); row.AutomaticSize = Enum.AutomaticSize.X; row.Size = UDim2.new(0, 0, 0, 46); row.BackgroundTransparency = 1; row.LayoutOrder = 3; row.Parent = ov
	local rl = Instance.new("UIListLayout"); rl.FillDirection = Enum.FillDirection.Horizontal; rl.Padding = UDim.new(0, 10); rl.Parent = row
	Ui.pill({ parent = row, label = "▶ Resume", variant = "solid", theme = App.state.theme, onClick = function() self:togglePause() end })
	Ui.pill({ parent = row, label = "↻ Restart", variant = "soft", theme = App.state.theme, onClick = function() self:restart() end })
	Ui.pill({ parent = row, label = "← Quit", variant = "ghost", theme = App.state.theme, onClick = function() self:quit() end })
	return ov
end

function Play:buildWin()
	local tok = Ui.tokens(App.state.theme)
	local ov = Instance.new("Frame")
	ov.Size = UDim2.new(1, 0, 1, 0)
	ov.BackgroundColor3 = tok.bg
	ov.BackgroundTransparency = 0.05
	ov.ZIndex = 20
	ov.Visible = false
	ov.Parent = self.stage
	local col = Instance.new("UIListLayout"); col.VerticalAlignment = Enum.VerticalAlignment.Center; col.HorizontalAlignment = Enum.HorizontalAlignment.Center; col.Padding = UDim.new(0, 10); col.Parent = ov
	self.winKicker = Ui.label({ parent = ov, text = "IMPOSSIBLE. YOU ACTUALLY DID IT.", color = tok.mut, font = Ui.FONT_MONO, textSize = 12, size = UDim2.new(1, 0, 0, 16), order = 1 })
	self.winKicker.TextXAlignment = Enum.TextXAlignment.Center
	self.winTitle = Ui.label({ parent = ov, text = "LEVEL CLEARED", color = tok.fg, font = Ui.FONT_HEAD, textSize = 46, size = UDim2.new(1, 0, 0, 56), order = 2 })
	self.winTitle.TextXAlignment = Enum.TextXAlignment.Center

	self.winStats = Instance.new("Frame")
	self.winStats.AutomaticSize = Enum.AutomaticSize.Y
	self.winStats.Size = UDim2.new(0, 0, 0, 40)
	self.winStats.BackgroundTransparency = 1
	self.winStats.LayoutOrder = 3
	self.winStats.Parent = ov
	local sl = Instance.new("UIListLayout"); sl.FillDirection = Enum.FillDirection.Horizontal; sl.HorizontalAlignment = Enum.HorizontalAlignment.Center; sl.Padding = UDim.new(0, 8); sl.Parent = self.winStats

	local row = Instance.new("Frame"); row.AutomaticSize = Enum.AutomaticSize.X; row.Size = UDim2.new(0, 0, 0, 46); row.BackgroundTransparency = 1; row.LayoutOrder = 4; row.Parent = ov
	local rl = Instance.new("UIListLayout"); rl.FillDirection = Enum.FillDirection.Horizontal; rl.Padding = UDim.new(0, 10); rl.Parent = row
	self.nextBtn = Ui.pill({ parent = row, label = "⚑ Next Level", variant = "solid", theme = App.state.theme, onClick = function()
		if self.winInfo and self.winInfo.nextId then self:startLevel(self.winInfo.nextId) end
	end })
	Ui.pill({ parent = row, label = "↻ Replay", variant = "soft", theme = App.state.theme, onClick = function() self:restart() end })
	Ui.pill({ parent = row, label = "← Levels", variant = "ghost", theme = App.state.theme, onClick = function() self:quit() end })
	return ov
end

-- ——— input ———
function Play:press(code, down)
	if self.eng then self.eng:press(code, down) end
end

function Play:bindInput()
	self.inputConnBegan = UserInputService.InputBegan:Connect(function(input, gp)
		if gp and input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		self:handleKey(input.KeyCode, true)
	end)
	self.inputConnEnded = UserInputService.InputEnded:Connect(function(input, gp)
		if gp and input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		self:handleKey(input.KeyCode, false)
	end)
end

function Play:handleKey(key, down)
	if not self.running or not self.eng then return end
	if key == Enum.KeyCode.Left or key == Enum.KeyCode.A then self:press("ArrowLeft", down)
	elseif key == Enum.KeyCode.Right or key == Enum.KeyCode.D then self:press("ArrowRight", down)
	elseif key == Enum.KeyCode.Space or key == Enum.KeyCode.Up or key == Enum.KeyCode.W then self:press("Space", down)
	elseif down and key == Enum.KeyCode.R then self:restart()
	elseif down and (key == Enum.KeyCode.Escape or key == Enum.KeyCode.P) then self:togglePause()
	elseif down and key == Enum.KeyCode.One then self:useReveal()
	elseif down and key == Enum.KeyCode.Two then self:useAnchor()
	end
end

-- ——— lifecycle ———
function Play:onEnter(levelId)
	levelId = tonumber(levelId) or self.levelId or 1
	local unlocked = App.state.unlockedLevel or 1
	if not Levels.getLevel(levelId) or levelId > unlocked then
		App.navigate("Locked", levelId)
		return
	end
	self:startLevel(levelId)
end

function Play:onExit()
	self:teardown()
end

function Play:startLevel(levelId)
	self:teardown()
	self.levelId = levelId
	local L = Levels.getLevel(levelId)
	local meta = nil
	for _, m in ipairs(Catalog.LEVEL_META) do if m.id == levelId then meta = m end end
	self.meta = meta

	local settings = App.state.settings or {}
	self.eng = Engine.new(L, App.palette(), {
		onDeath = function(info) self:onDeath(info) end,
		onWin = function(stats) self:onWin(stats) end,
		onToast = function(text) self:showToast(text) end,
	}, {
		viewW = VIEW_W, viewH = VIEW_H,
		skin = self:okCosmetic(settings.skin, "skin:solid"),
		trail = self:okCosmetic(settings.trail, "trail:none"),
		tauntKey = (self:okCosmetic(settings.taunt, "taunt:classic")):gsub("taunt:", ""),
		shakeEnabled = if settings.shake ~= nil then settings.shake else true,
	})
	self.eng:start()

	self.levelText.Text = string.format("LV %02d — %s", levelId, L.name)
	self.parLabel.Text = if meta then string.format("PAR %ds · DEATHLESS +%d · SPEED +%d", meta.par, meta.deathlessBonus, Catalog.SPEED_BONUS) else ""

	-- intro
	self.introLevel.Text = string.format("LEVEL %02d", levelId)
	self.introName.Text = L.name
	self.introTip.Text = L.tip
	self.intro.Visible = true
	self.introOn = true
	task.delay(2.1, function()
		if self.eng and self.levelId == levelId then
			self.intro.Visible = false
			self.introOn = false
		end
	end)

	self.winOv.Visible = false
	self.pauseOv.Visible = false
	self.winInfo = nil
	self.paused = false
	self.submitted = false
	self.running = true
	self.lastTs = os.clock()
	self:updateHud()

	Audio.sfx.levelStart()

	-- hud ticker
	self.hudConn = RunService.Heartbeat:Connect(function(dt) self:tick(dt) end)

	-- enable touch on coarse pointers
	self.touch.Visible = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function Play:okCosmetic(id, fallback)
	if not id then return fallback end
	local qty = App.ownedQty(id)
	if qty > 0 or id:sub(-5) == ":solid" or id:sub(-4) == ":none" or id:sub(-7) == ":classic" then
		return id
	end
	return fallback
end

function Play:teardown()
	self.running = false
	if self.hudConn then self.hudConn:Disconnect(); self.hudConn = nil end
	if self.eng then
		local d = self.eng.deaths
		self.eng:destroy()
		if not self.submitted and d > 0 then
			self:submitRun(false, d, 0, 0)
		end
		self.eng = nil
	end
end

function Play:tick(dt)
	if not self.running or not self.eng then return end
	local eng = self.eng
	if not eng.paused then
		eng.acc += math.min(0.05, dt)
		local steps = 0
		while eng.acc >= 1 / 60 and steps < 3 do
			eng:step(1 / 60)
			eng.acc -= 1 / 60
			steps += 1
		end
		if steps == 3 then eng.acc = 0 end
	end
	self.renderer:render(eng, eng.pal, dt)

	-- HUD
	self.reversed.Visible = eng:hud().reversed
	if eng.clock < eng.toastUntil and eng.toastText ~= "" then
		self.toast.Visible = true
		self.toast.Text = eng.toastText
		self.toast.TextTransparency = 0
	else
		self.toast.Visible = false
	end
	self:updateHud()
end

function Play:updateHud()
	if not self.eng then return end
	local h = self.eng:hud()
	self.timeText.Text = Utils.fmtClock(h.timeMs)
	self.deathsText.Text = string.format("☠ %d", h.deaths)
	self.coinsText.Text = string.format("● %d", h.coins)
end

function Play:showToast(text)
	self.toast.Text = text
	self.toast.Visible = true
	if self.toastTimer then task.cancel(self.toastTimer) end
	self.toastTimer = task.delay(2.3, function()
		-- engine's own toastUntil may still be showing; only hide if engine done
		if not self.eng or self.eng.clock >= self.eng.toastUntil then
			self.toast.Visible = false
		end
	end)
end

function Play:onDeath(info)
	self.deathsText.Text = string.format("☠ %d", info.count)
end

function Play:onWin(stats)
	if self.submitted then return end
	self:submitRun(true, stats.deaths, stats.timeMs, stats.coins, stats)
end

function Play:submitRun(won, deaths, timeMs, coins, stats)
	if self.submitted then return end
	self.submitted = true
	task.spawn(function()
		local ok, res = pcall(function()
			return Remotes.SubmitRun:InvokeServer({
				levelId = self.levelId, won = won, runDeaths = deaths, timeMs = timeMs, coins = coins,
			})
		end)
		if ok and res then
			if App.state.profile and res.profile then App.state.profile = res.profile end
			if res.unlockedLevel then App.state.unlockedLevel = res.unlockedLevel end
			if res.newAchievements and #res.newAchievements > 0 then
				for _, key in ipairs(res.newAchievements) do
					local def = nil
					for _, a in ipairs(Catalog.ACHIEVEMENTS) do if a.key == key then def = a end end
					if def then
						App.notify("ACHIEVEMENT · " .. def.name, def.desc, "success")
						Audio.sfx.achievement()
					end
				end
			end
			if won then
				self:showWin(stats or { timeMs = timeMs, deaths = deaths, coins = coins }, res)
			end
		else
			self.submitted = false
			App.notify("SYNC FAILED", "YOUR PAIN WAS NOT RECORDED", "error")
		end
	end)
end

function Play:showWin(stats, res)
	self.winInfo = { stats = stats, coinsEarned = res.coinsEarned, firstClear = res.firstClear, nextId = self.levelId + 1 }
	self.winStats:ClearAllChildren()
	local tok = Ui.tokens(App.state.theme)
	local sl = Instance.new("UIListLayout"); sl.FillDirection = Enum.FillDirection.Horizontal; sl.HorizontalAlignment = Enum.HorizontalAlignment.Center; sl.Padding = UDim.new(0, 8); sl.Parent = self.winStats
	Ui.chip({ parent = self.winStats, text = "TIME " .. Utils.fmtTime(stats.timeMs), theme = App.state.theme, height = 40, textSize = 12, order = 1 })
	Ui.chip({ parent = self.winStats, text = string.format("☠ %d DEATHS", stats.deaths), theme = App.state.theme, height = 40, textSize = 12, order = 2 })
	Ui.chip({ parent = self.winStats, text = string.format("● +%d", res.coinsEarned), theme = App.state.theme, height = 40, textSize = 12, solid = true, order = 3 })
	if res.firstClear then
		Ui.chip({ parent = self.winStats, text = "FIRST CLEAR", theme = App.state.theme, height = 40, textSize = 12, order = 4 })
	end
	self.winOv.Visible = true
end

function Play:restart()
	if not self.eng then return end
	Audio.sfx.restart()
	local d = self.eng.deaths
	local alreadyBanked = self.eng.won
	self.winOv.Visible = false
	self.pauseOv.Visible = false
	self.winInfo = nil
	self.paused = false
	self.eng.paused = false
	self.submitted = false
	self.eng:rebuild(false)
	self.running = true
	self:updateHud()
	if d > 0 and not alreadyBanked then
		self:submitRun(false, d, 0, 0)
		self.submitted = false
	end
end

function Play:togglePause()
	local eng = self.eng
	if not eng or eng.won then return end
	eng.paused = not eng.paused
	self.paused = eng.paused
	if eng.paused then
		Audio.sfx.pause()
		self.pauseOv.Visible = true
	else
		Audio.sfx.resume()
		self.pauseOv.Visible = false
	end
end

function Play:useReveal()
	local eng = self.eng
	if not eng or eng.won then return end
	if App.ownedQty("gear:reveal") <= 0 then
		App.notify("NO TRAP-SCOPE", "THE SHOP SELLS MORE", "error")
		return
	end
	task.spawn(function()
		local ok = pcall(function() return Remotes.UseItem:InvokeServer({ itemId = "gear:reveal" }) end)
		if ok then
			eng:useReveal()
			App.state.owned["gear:reveal"] = math.max(0, App.ownedQty("gear:reveal") - 1)
			self:refreshGearLabel(self.scopeBtn, "✛", "SCOPE", "gear:reveal")
		else
			App.notify("NO TRAP-SCOPE", "THE SHOP SELLS MORE", "error")
		end
	end)
end

function Play:useAnchor()
	local eng = self.eng
	if not eng or eng.won then return end
	if App.ownedQty("gear:pass") <= 0 then
		App.notify("NO ANCHOR", "THE SHOP SELLS MORE", "error")
		return
	end
	if not eng:placeCheckpoint() then
		Audio.sfx.denied()
		return
	end
	task.spawn(function()
		local ok = pcall(function() return Remotes.UseItem:InvokeServer({ itemId = "gear:pass" }) end)
		if ok then
			App.state.owned["gear:pass"] = math.max(0, App.ownedQty("gear:pass") - 1)
			self:refreshGearLabel(self.anchorBtn, "⚑", "ANCHOR", "gear:pass")
		end
	end)
end

function Play:quit()
	self:teardown()
	App.navigate("Levels")
end

return Play
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Settings</string>
            <string name="Source"><![CDATA[--!strict
-- EXOTIC Settings screen — port of src/app/settings/page.tsx. Theme, sound/
-- volume, screen shake, cosmetic equips, sign out, account delete.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local App = require(Shared:WaitForChild("App"))
local Ui = require(Shared:WaitForChild("Ui"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Audio = require(Shared:WaitForChild("Audio"))

local Settings = {}
Settings.__index = Settings

function Settings.build()
	local self = setmetatable({}, Settings)
	local shell = Ui.shell({
		parent = App.root, name = "Settings", title = "SETTINGS", backLabel = "← Home",
		onBack = function() App.navigate("Home") end, theme = App.state.theme, visible = false,
	})
	self.screen = shell.screen
	self.body = shell.body
	self.controls = {}

	-- THEME
	self:addHeading("THEME")
	self.themeRow = self:addSegmented({ "dark", "light" }, function(v) self:patch({ theme = v }) end)

	-- SOUND
	self:addHeading("SOUND")
	self.soundRow = self:addToggle("soundBtn", function(on) self:patch({ sound = on }) end)

	-- VOLUME
	self:addHeading("VOLUME")
	self.volumeRow = self:addSlider(function(v) self:patch({ volume = v }) end)

	-- SCREEN SHAKE
	self:addHeading("SCREEN SHAKE")
	self.shakeRow = self:addToggle("shakeBtn", function(on) self:patch({ shake = on }) end)

	-- EQUIP SKIN / TRAIL / TAUNT
	self:addHeading("EQUIPPED SKIN")
	self.skinRow = self:addEquipPicker("skin")
	self:addHeading("EQUIPPED TRAIL")
	self.trailRow = self:addEquipPicker("trail")
	self:addHeading("EQUIPPED TAUNT")
	self.tauntRow = self:addEquipPicker("taunt")

	-- account
	self:addHeading("ACCOUNT")
	local row = Instance.new("Frame"); row.AutomaticSize = Enum.AutomaticSize.Y; row.Size = UDim2.new(1, 0, 0, 44); row.BackgroundTransparency = 1; row.Parent = self.body
	local rl = Instance.new("UIListLayout"); rl.FillDirection = Enum.FillDirection.Horizontal; rl.Padding = UDim.new(0, 10); rl.Parent = row
	self.acctLabel = Ui.label({ parent = row, text = "", color = Ui.tokens(App.state.theme).mut, font = Ui.FONT_MONO, textSize = 12, size = UDim2.new(1, -260, 0, 40), xAlign = Enum.TextXAlignment.Left })

	self.deleteBtn = Ui.pill({ parent = row, label = "DELETE ACCOUNT", variant = "ghost", size = "sm", theme = App.state.theme, width = 160, onClick = function() self:armDelete() end })

	return self
end

function Settings:addHeading(text)
	local tok = Ui.tokens(App.state.theme)
	local l = Ui.label({ parent = self.body, text = text, color = tok.mut, font = Ui.FONT_MONO_BOLD, textSize = 11, size = UDim2.new(1, 0, 0, 20), order = #self.controls + 1 })
	l.Position = UDim2.new(0, 0, 0, 0)
	-- use layout order via a wrapper frame for spacing
	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(1, 0, 0, 44)
	wrap.BackgroundTransparency = 1
	wrap.LayoutOrder = #self.controls + 1
	wrap.Parent = self.body
	l.Parent = wrap
	l.Position = UDim2.new(0, 0, 0, 0)
	l.Size = UDim2.new(1, 0, 0, 20)
	table.insert(self.controls, wrap)
	return wrap
end

-- helper to add a labeled control row under the last heading
function Settings:attachRow(factory)
	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(1, 0, 0, 42)
	wrap.BackgroundTransparency = 1
	wrap.LayoutOrder = #self.controls + 1
	wrap.Parent = self.body
	table.insert(self.controls, wrap)
	factory(wrap)
	return wrap
end

function Settings:addSegmented(options, onChange)
	local wrap = self:attachRow(function(w)
		local tok = Ui.tokens(App.state.theme)
		local seg = Instance.new("Frame")
		seg.Size = UDim2.new(0, 10, 0, 36)
		seg.AutomaticSize = Enum.AutomaticSize.X
		seg.BackgroundColor3 = tok.pan
		seg.Parent = w
		Ui.corner(seg, 18)
		local l = Instance.new("UIListLayout"); l.FillDirection = Enum.FillDirection.Horizontal; l.Padding = UDim.new(0, 4); l.Parent = seg
		Ui.pad(seg, 4, 4, 4, 4)
		self.segButtons = {}
		for _, opt in ipairs(options) do
			local b = Instance.new("TextButton")
			b.AutoButtonColor = false
			b.Size = UDim2.new(0, 10, 0, 28)
			b.AutomaticSize = Enum.AutomaticSize.X
			b.BackgroundTransparency = 1
			b.TextColor3 = tok.mut
			b.Text = string.upper(opt)
			b.FontFace = Ui.FONT_MONO_BOLD
			b.TextSize = 12
			b.Parent = seg
			Ui.pad(b, 18, 0, 18, 0)
			b.MouseButton1Click:Connect(function() Audio.sfx.toggle(); onChange(opt) end)
			table.insert(self.segButtons, { btn = b, value = opt })
		end
	end)
	self.segWrap = wrap
	return wrap
end

function Settings:addToggle(fieldName, onChange)
	return self:attachRow(function(w)
		local tok = Ui.tokens(App.state.theme)
		local b = Instance.new("TextButton")
		b.AutoButtonColor = false
		b.Size = UDim2.new(0, 72, 0, 32)
		b.BackgroundColor3 = tok.pan
		b.TextColor3 = tok.fg
		b.Text = "OFF"
		b.FontFace = Ui.FONT_MONO_BOLD
		b.TextSize = 12
		b.BorderSizePixel = 0
		b.Parent = w
		Ui.corner(b, 16)
		if fieldName then self[fieldName] = b end
		b.MouseButton1Click:Connect(function()
			Audio.sfx.toggle()
			local on = b.Text == "OFF"
			onChange(on)
		end)
	end)
end

function Settings:addSlider(onChange)
	return self:attachRow(function(w)
		local tok = Ui.tokens(App.state.theme)
		local track = Instance.new("Frame")
		track.Size = UDim2.new(0, 220, 0, 8)
		track.BackgroundColor3 = tok.pan2
		track.BorderSizePixel = 0
		track.Parent = w
		track.Position = UDim2.new(0, 0, 0.5, -4)
		Ui.corner(track, 4)
		local fill = Instance.new("Frame")
		fill.Size = UDim2.new(0.6, 0, 1, 0)
		fill.BackgroundColor3 = tok.fg
		fill.BorderSizePixel = 0
		fill.Parent = track
		Ui.corner(fill, 4)
		self.sliderFill = fill
		local knob = Instance.new("Frame")
		knob.Size = UDim2.new(0, 16, 0, 16)
		knob.BackgroundColor3 = tok.fg
		knob.BorderSizePixel = 0
		knob.Position = UDim2.new(0.6, -8, 0.5, -8)
		knob.Parent = track
		Ui.corner(knob, 8)
		self.sliderKnob = knob
		self.sliderValue = Ui.label({ parent = w, text = "60", color = tok.mut, font = Ui.FONT_MONO_BOLD, textSize = 12, size = UDim2.new(0, 40, 0, 16), xAlign = Enum.TextXAlignment.Left })
		self.sliderValue.Position = UDim2.new(0, 232, 0.5, -8)

		-- click/drag to set
		local dragging = false
		local function setFromX(x)
			local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
			local v = math.floor(rel * 100 + 0.5)
			fill.Size = UDim2.new(rel, 0, 1, 0)
			knob.Position = UDim2.new(rel, -8, 0.5, -8)
			self.sliderValue.Text = tostring(v)
			Audio.sfx.slider()
			onChange(v)
		end
		track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				setFromX(input.Position.X)
			end
		end)
		knob.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
		end)
		game:GetService("UserInputService").InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				setFromX(input.Position.X)
			end
		end)
		game:GetService("UserInputService").InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
		end)
	end)
end

function Settings:addEquipPicker(category)
	local wrap = self:attachRow(function(w)
		local tok = Ui.tokens(App.state.theme)
		local picker = Instance.new("ScrollingFrame")
		picker.Size = UDim2.new(1, 0, 0, 40)
		picker.BackgroundTransparency = 1
		picker.ScrollBarThickness = 0
		picker.CanvasSize = UDim2.new(0, 0, 0, 0)
		picker.AutomaticCanvasSize = Enum.AutomaticSize.X
		picker.Parent = w
		local l = Instance.new("UIListLayout"); l.FillDirection = Enum.FillDirection.Horizontal; l.Padding = UDim.new(0, 8); l.Parent = picker
		self.pickers = self.pickers or {}
		local buttons = {}
		for _, item in ipairs(Catalog.SHOP_ITEMS) do
			if item.category == category then
				local b = Instance.new("TextButton")
				b.AutoButtonColor = false
				b.Size = UDim2.new(0, 10, 0, 32)
				b.AutomaticSize = Enum.AutomaticSize.X
				b.BackgroundColor3 = tok.pan
				b.TextColor3 = tok.fg
				b.Text = item.name
				b.FontFace = Ui.FONT_MONO_BOLD
				b.TextSize = 11
				b.BorderSizePixel = 0
				b.Parent = picker
				Ui.pad(b, 14, 0, 14, 0)
				Ui.corner(b, 16)
				b.MouseButton1Click:Connect(function()
					Audio.sfx.select()
					local field = category
					self:patch({ [field] = item.id })
				end)
				table.insert(buttons, { btn = b, id = item.id })
			end
		end
		self.pickers[category] = buttons
	end)
	return wrap
end

function Settings:patch(patch)
	task.spawn(function()
		local ok, res = pcall(function() return Remotes.PatchSettings:InvokeServer(patch) end)
		if ok and res and res.settings then
			local prevTheme = App.state.theme
			App.state.settings = res.settings
			if res.settings.theme and res.settings.theme ~= prevTheme then
				App.setTheme(res.settings.theme)
			end
			Audio.sfx.configure({
				enabled = res.settings.sound ~= false,
				volume = (res.settings.volume or 60) / 100,
			})
			self:refresh()
		end
	end)
end

function Settings:armDelete()
	if self.armed then return end
	self.armed = true
	self.deleteBtn.Text = "CONFIRM DELETE"
	self.deleteBtn.BackgroundColor3 = Color3.fromHex("8b1a1a")
	task.delay(4, function()
		self.armed = false
		if self.deleteBtn then
			self.deleteBtn.Text = "DELETE ACCOUNT"
			self.deleteBtn.BackgroundColor3 = Color3.new(0, 0, 0)
			self.deleteBtn.BackgroundTransparency = 1
		end
	end)
end

function Settings:refresh()
	local s = App.state.settings or {}
	-- segmented theme
	for _, seg in ipairs(self.segButtons or {}) do
		local tok = Ui.tokens(App.state.theme)
		if seg.value == s.theme then
			seg.btn.BackgroundColor3 = tok.fg
			seg.btn.TextColor3 = tok.bg
		else
			seg.btn.BackgroundTransparency = 1
			seg.btn.TextColor3 = tok.mut
		end
	end
	-- toggles
	if self.soundBtn then self.soundBtn.Text = if s.sound == false then "OFF" else "ON" end
	if self.shakeBtn then self.shakeBtn.Text = if s.shake == false then "OFF" else "ON" end
	-- volume
	local vol = s.volume or 60
	if self.sliderFill then self.sliderFill.Size = UDim2.new(vol / 100, 0, 1, 0) end
	if self.sliderKnob then self.sliderKnob.Position = UDim2.new(vol / 100, -8, 0.5, -8) end
	if self.sliderValue then self.sliderValue.Text = tostring(vol) end
	-- equipped pickers
	for category, buttons in pairs(self.pickers or {}) do
		local current = s[category]
		for _, entry in ipairs(buttons) do
			local tok = Ui.tokens(App.state.theme)
			local owned = App.ownedQty(entry.id) > 0 or entry.id:sub(-5) == ":solid" or entry.id:sub(-4) == ":none" or entry.id:sub(-7) == ":classic"
			if entry.id == current then
				entry.btn.BackgroundColor3 = tok.fg
				entry.btn.TextColor3 = tok.bg
			elseif not owned then
				entry.btn.BackgroundColor3 = tok.pan2
				entry.btn.TextColor3 = tok.mut
			else
				entry.btn.BackgroundColor3 = tok.pan
				entry.btn.TextColor3 = tok.fg
			end
		end
	end
	-- account
	local acct = App.state.account
	if acct then
		self.acctLabel.Text = string.format("SIGNED IN AS %s · ● %d COINS", string.upper(acct.username), App.coins())
	end
end

function Settings:onEnter()
	self:refresh()
end

function Settings:onExit() end

return Settings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[--!strict
-- EXOTIC Shop screen — port of src/app/shop/page.tsx. Four categories with
-- live per-item preview canvases, buy + equip.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local App = require(Shared:WaitForChild("App"))
local Ui = require(Shared:WaitForChild("Ui"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local Preview = require(Shared:WaitForChild("Preview"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Audio = require(Shared:WaitForChild("Audio"))

local Shop = {}
Shop.__index = Shop

function Shop.build()
	local self = setmetatable({}, Shop)
	local shell = Ui.shell({
		parent = App.root, name = "Shop", title = "SHOP", backLabel = "← Home",
		onBack = function() App.navigate("Home") end, theme = App.state.theme, visible = false,
	})
	self.screen = shell.screen
	self.body = shell.body
	self.items = {}

	-- coins chip in header
	self.coinsChip, self.coinsText = Ui.chip({ parent = shell.right, text = "● 0", theme = App.state.theme, height = 32, textSize = 12, order = 1 })

	-- category tabs
	local tabs = Instance.new("Frame")
	tabs.Size = UDim2.new(1, 0, 0, 38)
	tabs.BackgroundTransparency = 1
	tabs.Parent = shell.body
	local tl = Instance.new("UIListLayout"); tl.FillDirection = Enum.FillDirection.Horizontal; tl.Padding = UDim.new(0, 8); tl.Parent = tabs
	self.tabButtons = {}
	self.activeCategory = "skin"
	for _, cat in ipairs(Catalog.CATEGORIES) do
		local b = Ui.pill({ parent = tabs, label = Catalog.categoryLabel(cat), variant = "soft", size = "sm", theme = App.state.theme, order = #self.tabButtons + 1, onClick = function() self:setCategory(cat) end })
		table.insert(self.tabButtons, { btn = b, cat = cat })
	end

	-- item list
	local list = Instance.new("Frame")
	list.Size = UDim2.new(1, 0, 0, 0)
	list.AutomaticSize = Enum.AutomaticSize.Y
	list.Position = UDim2.new(0, 0, 0, 48)
	list.BackgroundTransparency = 1
	list.Parent = shell.body
	local ll = Instance.new("UIListLayout"); ll.Padding = UDim.new(0, 10); ll.Parent = list
	self.list = list

	return self
end

function Shop:setCategory(cat)
	self.activeCategory = cat
	self:renderItems()
end

function Shop:renderItems()
	-- destroy old previews + rows
	for _, item in ipairs(self.items) do
		if item.preview then item.preview:destroy() end
		if item.row then item.row:Destroy() end
	end
	self.items = {}

	local tok = Ui.tokens(App.state.theme)
	for order, itemDef in ipairs(Catalog.SHOP_ITEMS) do
		if itemDef.category == self.activeCategory then
			table.insert(self.items, self:buildRow(itemDef, #self.items + 1))
		end
	end
	self:refresh()
end

function Shop:buildRow(itemDef, order)
	local tok = Ui.tokens(App.state.theme)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 96)
	row.BackgroundColor3 = tok.pan
	row.BorderSizePixel = 0
	row.LayoutOrder = order
	row.Parent = self.list
	Ui.corner(row, 14)

	-- preview
	local previewHolder = Instance.new("Frame")
	previewHolder.Size = UDim2.new(0, 140, 1, -16)
	previewHolder.Position = UDim2.new(0, 8, 0, 8)
	previewHolder.BackgroundColor3 = Color3.fromHex(if App.state.theme == "dark" then "0b0b0c" else "f1f1ee")
	previewHolder.BorderSizePixel = 0
	previewHolder.ClipsDescendants = true
	previewHolder.Parent = row
	Ui.corner(previewHolder, 10)

	-- text
	Ui.label({ parent = row, text = itemDef.name, color = tok.fg, font = Ui.FONT_HEAD, textSize = 16, size = UDim2.new(1, -320, 0, 22), order = 2 }).Position = UDim2.new(0, 158, 0, 14)
	Ui.label({ parent = row, text = itemDef.blurb, color = tok.mut, font = Ui.FONT_MONO, textSize = 11, size = UDim2.new(1, -320, 0, 40), wrapped = true, order = 3 }).Position = UDim2.new(0, 158, 0, 38)

	-- action button
	local action = Instance.new("TextButton")
	action.AutoButtonColor = false
	action.Size = UDim2.new(0, 120, 0, 38)
	action.Position = UDim2.new(1, -12, 0.5, -19)
	action.AnchorPoint = Vector2.new(1, 0)
	action.BorderSizePixel = 0
	action.FontFace = Ui.FONT_MONO_BOLD
	action.TextSize = 12
	action.Parent = row
	Ui.corner(action, 19)

	-- equip indicator for owned permanents
	local equipped = Instance.new("TextLabel")
	equipped.Size = UDim2.new(0, 10, 0, 20)
	equipped.AutomaticSize = Enum.AutomaticSize.X
	equipped.Position = UDim2.new(1, -140, 0.5, -10)
	equipped.BackgroundTransparency = 1
	equipped.Text = "✓ EQUIPPED"
	equipped.TextColor3 = tok.fg
	equipped.FontFace = Ui.FONT_MONO_BOLD
	equipped.TextSize = 10
	equipped.Visible = false
	equipped.Parent = row

	action.MouseButton1Click:Connect(function()
		self:onAction(itemDef, action, equipped)
	end)

	local preview = nil
	local spec = Preview.Preview.previewSpecFor(itemDef.id)
	if spec then
		preview = Preview.PreviewPlayer.new(previewHolder, spec, App.state.theme, 140, 80)
	end

	return { row = row, def = itemDef, action = action, equipped = equipped, preview = preview }
end

function Shop:isEquipped(def)
	local s = App.state.settings or {}
	if def.category == "skin" then return s.skin == def.id end
	if def.category == "trail" then return s.trail == def.id end
	if def.category == "taunt" then return s.taunt == def.id end
	return false
end

function Shop:onAction(def, action, equipped)
	if def.category == "gear" then
		-- consumable: always buy more
		self:buy(def)
		return
	end
	local owned = App.ownedQty(def.id) > 0 or def.price == 0
	if not owned then
		self:buy(def)
	else
		self:equip(def)
	end
end

function Shop:buy(def)
	task.spawn(function()
		local ok, res = pcall(function() return Remotes.BuyItem:InvokeServer({ itemId = def.id }) end)
		if ok and res and res.ok then
			if res.profile then App.state.profile = res.profile end
			if res.owned then App.state.owned = res.owned end
			if res.newAchievements then
				for _, key in ipairs(res.newAchievements) do
					local d = nil
					for _, a in ipairs(Catalog.ACHIEVEMENTS) do if a.key == key then d = a end end
					if d then App.notify("ACHIEVEMENT · " .. d.name, d.desc, "success") end
				end
			end
			Audio.sfx.buy()
			App.notify("PURCHASED", def.name .. " IS YOURS", "silent")
			self:refresh()
		else
			Audio.sfx.denied()
			App.notify("NOT ENOUGH COINS", (res and res.error) or "THE GRIND CONTINUES", "error")
		end
	end)
end

function Shop:equip(def)
	local field = if def.category == "skin" then "skin" elseif def.category == "trail" then "trail" else "taunt"
	local patch = { [field] = def.id }
	task.spawn(function()
		local ok, res = pcall(function() return Remotes.PatchSettings:InvokeServer(patch) end)
		if ok and res and res.settings then
			App.state.settings = res.settings
			Audio.sfx.select()
			App.notify("EQUIPPED", def.name, "silent")
			self:refresh()
		end
	end)
end

function Shop:refresh()
	self.coinsText.Text = string.format("● %d", App.coins())
	for _, item in ipairs(self.items) do
		local def = item.def
		local owned = App.ownedQty(def.id) > 0 or def.price == 0
		local equipped = self:isEquipped(def)
		item.equipped.Visible = equipped and def.category ~= "gear"
		local tok = Ui.tokens(App.state.theme)
		local isGear = def.category == "gear"
		if not isGear and equipped then
			item.action.Text = "EQUIPPED"
			item.action.BackgroundColor3 = tok.pan2
			item.action.TextColor3 = tok.mut
		elseif not isGear and owned then
			item.action.Text = "EQUIP"
			item.action.BackgroundColor3 = tok.fg
			item.action.TextColor3 = tok.bg
		else
			item.action.Text = string.format("BUY ● %d", def.price)
			item.action.BackgroundColor3 = tok.fg
			item.action.TextColor3 = tok.bg
		end
	end
end

function Shop:onEnter()
	if not self.rendered then
		self.rendered = true
		self:renderItems()
	else
		self:refresh()
	end
end

function Shop:onExit()
	for _, item in ipairs(self.items) do
		if item.preview then item.preview:destroy(); item.preview = nil end
	end
	self.rendered = false
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Splash</string>
            <string name="Source"><![CDATA[--!strict
-- EXOTIC Splash — animated boot splash (port of src/components/splash.tsx).
-- Cycles loading lines for ~2.6s then navigates to Home.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local App = require(Shared:WaitForChild("App"))
local Ui = require(Shared:WaitForChild("Ui"))
local Audio = require(Shared:WaitForChild("Audio"))

local Splash = {}
Splash.__index = Splash

local LINES = {
	"BOOTING EXOTIC…",
	"CALIBRATING TRAPS…",
	"ARMING SPIKES…",
	"DOUBTING FLOORS…",
	"READY.",
}

function Splash.build()
	local self = setmetatable({}, Splash)
	local tok = Ui.tokens("dark")
	local screen = Instance.new("Frame")
	screen.Name = "Splash"
	screen.Size = UDim2.new(1, 0, 1, 0)
	screen.BackgroundColor3 = tok.bg
	screen.BorderSizePixel = 0
	screen.Visible = false
	screen.ZIndex = 50
	screen.Parent = App.root
	self.screen = screen

	local col = Instance.new("UIListLayout")
	col.VerticalAlignment = Enum.VerticalAlignment.Center
	col.HorizontalAlignment = Enum.HorizontalAlignment.Center
	col.Padding = UDim.new(0, 10)
	col.Parent = screen

	local brand = Ui.label({ parent = screen, text = "◆ EXOTIC", color = tok.fg, font = Ui.FONT_HEAD, textSize = 44, size = UDim2.new(0, 400, 0, 60), xAlign = Enum.TextXAlignment.Center, order = 1 })
	self.line = Ui.label({ parent = screen, text = LINES[1], color = tok.mut, font = Ui.FONT_MONO_BOLD, textSize = 13, size = UDim2.new(0, 400, 0, 20), xAlign = Enum.TextXAlignment.Center, order = 2 })
	return self
end

function Splash:onEnter()
	Audio.sfx.boot()
	self.screen.Visible = true
	task.delay(2.6, function()
		if self.screen and self.screen.Parent then
			self.screen.Visible = false
			local ok, err = pcall(function() App.navigate("Home") end)
			if not ok then warn("[EXOTIC] Splash→Home failed: " .. tostring(err)) end
		end
	end)
end

function Splash:onExit() end

return Splash
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Ui</string>
          <string name="Source"><![CDATA[--!strict
-- EXOTIC UI kit — a theme-aware port of the web design system (globals.css +
-- pill-button.tsx + screen-shell.tsx). Every builder derives colors from the
-- current App theme so light/dark swap live, matching the CSS variables.

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))

local Ui = {}

Ui.FONT_MONO_BOLD = Font.new("rbxasset://fonts/families/Inconsolata.json", Enum.FontWeight.Bold)
Ui.FONT_MONO = Font.new("rbxasset://fonts/families/Inconsolata.json", Enum.FontWeight.Medium)
Ui.FONT_HEAD = Font.new("rbxasset://fonts/families/Inconsolata.json", Enum.FontWeight.Bold)

-- theme tokens (light values; dark overrides below)
local THEMES = {
	light = {
		bg = "f1f1ee", fg = "101010", mut = "6d6d67",
		pan = "e4e4e0", pan2 = "d7d7d2", text = "000000",
	},
	dark = {
		bg = "0b0b0c", fg = "fafafa", mut = "8a8a86",
		pan = "17171a", pan2 = "202024", text = "fafafa",
	},
}

function Ui.tokens(theme)
	local t = THEMES[theme] or THEMES.dark
	return {
		bg = Color3.fromHex(t.bg), fg = Color3.fromHex(t.fg), mut = Color3.fromHex(t.mut),
		pan = Color3.fromHex(t.pan), pan2 = Color3.fromHex(t.pan2), text = Color3.fromHex(t.text),
	}
end

function Ui.corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 16)
	c.Parent = parent
	return c
end

function Ui.pad(parent, l, t, r, b)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, l or 0)
	p.PaddingTop = UDim.new(0, t or 0)
	p.PaddingRight = UDim.new(0, r or 0)
	p.PaddingBottom = UDim.new(0, b or 0)
	p.Parent = parent
	return p
end

function Ui.stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

function Ui.label(props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = props.size or UDim2.new(0, 0, 0, 20)
	if props.automatic then l.AutomaticSize = props.automatic end
	l.Text = props.text or ""
	l.TextColor3 = props.color
	l.FontFace = props.font or Ui.FONT_MONO
	l.TextSize = props.textSize or 14
	l.TextWrapped = props.wrapped == true
	l.TextXAlignment = props.xAlign or Enum.TextXAlignment.Left
	l.TextYAlignment = props.yAlign or Enum.TextYAlignment.Center
	l.TextTransparency = props.transparency or 0
	l.LayoutOrder = props.order or 0
	l.Parent = props.parent
	if props.name then l.Name = props.name end
	return l
end

-- Pill button. variant: "solid" | "soft" | "ghost". Mirrors PillButton.tsx.
function Ui.pill(props)
	local theme = props.theme or "dark"
	local tok = Ui.tokens(theme)
	local variant = props.variant or "solid"
	local size = props.size or "md"
	local heights = { sm = 34, md = 42, lg = 50 }
	local paddings = { sm = 16, md = 24, lg = 30 }
	local h = heights[size] or 42

	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.Selectable = false
	b.Size = UDim2.new(0, 10, 0, h)
	b.AutomaticSize = Enum.AutomaticSize.X
	b.BorderSizePixel = 0
	if props.width then
		b.AutomaticSize = Enum.AutomaticSize.None
		b.Size = UDim2.new(0, props.width, 0, h)
	end
	b.Text = props.label or ""
	b.FontFace = Ui.FONT_MONO_BOLD
	b.TextSize = if size == "sm" then 11 else 13
	b.TextXAlignment = Enum.TextXAlignment.Center

	if variant == "solid" then
		b.BackgroundColor3 = tok.fg
		b.TextColor3 = tok.bg
	elseif variant == "soft" then
		b.BackgroundColor3 = tok.pan
		b.TextColor3 = tok.fg
	else -- ghost
		b.BackgroundColor3 = Color3.new(0, 0, 0)
		b.BackgroundTransparency = 1
		b.TextColor3 = tok.fg
	end
	Ui.corner(b, 24)
	Ui.pad(b, paddings[size] or 24, 0, paddings[size] or 24, 0)
	if props.order then b.LayoutOrder = props.order end
	b.Parent = props.parent

	b.MouseEnter:Connect(function() Audio.sfx.hover() end)
	b.MouseButton1Click:Connect(function()
		Audio.sfx.nav()
		if props.onClick then props.onClick() end
	end)
	return b
end

-- Circular icon-ish button (pause, theme toggle). Returns TextButton.
function Ui.iconButton(props)
	local theme = props.theme or "dark"
	local tok = Ui.tokens(theme)
	local size = props.size or 36
	local b = Instance.new("TextButton")
	b.Name = props.name or "IconButton"
	b.AutoButtonColor = false
	b.Selectable = false
	b.Size = UDim2.new(0, size, 0, size)
	b.BackgroundColor3 = tok.pan
	b.TextColor3 = tok.fg
	b.Text = props.text or ""
	b.FontFace = Ui.FONT_MONO_BOLD
	b.TextSize = props.textSize or 16
	b.BorderSizePixel = 0
	Ui.corner(b, size / 2)
	if props.order then b.LayoutOrder = props.order end
	b.Parent = props.parent
	b.MouseEnter:Connect(function() Audio.sfx.hover() end)
	b.MouseButton1Click:Connect(function()
		Audio.sfx.click()
		if props.onClick then props.onClick() end
	end)
	return b
end

-- Pill stat chip used in HUD + win overlay.
function Ui.chip(props)
	local theme = props.theme or "dark"
	local tok = Ui.tokens(theme)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(0, 10, 0, props.height or 36)
	f.AutomaticSize = Enum.AutomaticSize.X
	f.BorderSizePixel = 0
	local solid = props.solid
	f.BackgroundColor3 = if solid then tok.fg else tok.pan
	Ui.corner(f, 20)
	Ui.pad(f, 16, 0, 16, 0)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 6)
	layout.Parent = f
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.new(0, 0, 1, 0)
	t.AutomaticSize = Enum.AutomaticSize.X
	t.Text = props.text or ""
	t.TextColor3 = if solid then tok.bg else tok.fg
	t.FontFace = Ui.FONT_MONO_BOLD
	t.TextSize = props.textSize or 12
	t.Parent = f
	if props.order then f.LayoutOrder = props.order end
	f.Parent = props.parent
	return f, t
end

-- ScreenShell: header (back/title/right) + scrollable body. Mirrors ScreenShell.tsx.
function Ui.shell(props)
	local theme = props.theme or "dark"
	local tok = Ui.tokens(theme)

	local screen = Instance.new("Frame")
	screen.Name = props.name or "Screen"
	screen.Size = UDim2.new(1, 0, 1, 0)
	screen.BackgroundColor3 = tok.bg
	screen.BorderSizePixel = 0
	screen.Visible = props.visible == true
	screen.Parent = props.parent

	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, -40, 1, -30)
	container.Position = UDim2.new(0, 20, 0, 15)
	container.BackgroundTransparency = 1
	container.Parent = screen

	-- header
	local header = Instance.new("Frame")
	header.Size = UDim2.new(1, 0, 0, 44)
	header.BackgroundTransparency = 1
	header.Parent = container

	if props.backLabel then
		local back = Ui.pill({
			parent = header, label = props.backLabel, variant = "ghost", size = "sm",
			theme = theme, width = 110, onClick = props.onBack,
		})
		back.Position = UDim2.new(0, 0, 0, 4)
	end

	local titleCol = Instance.new("Frame")
	titleCol.Size = UDim2.new(1, -240, 1, 0)
	titleCol.Position = UDim2.new(0, if props.backLabel then 120 else 0, 0, 0)
	titleCol.BackgroundTransparency = 1
	titleCol.Parent = header
	Ui.label({
		parent = titleCol, text = props.title or "", color = tok.fg,
		font = Ui.FONT_HEAD, textSize = 18, xAlign = Enum.TextXAlignment.Left,
		size = UDim2.new(1, 0, 0, 24),
	})

	-- right cluster
	local right = Instance.new("Frame")
	right.Size = UDim2.new(0, 10, 0, 44)
	right.AutomaticSize = Enum.AutomaticSize.X
	right.Position = UDim2.new(1, 0, 0, 0)
	right.AnchorPoint = Vector2.new(1, 0)
	right.BackgroundTransparency = 1
	right.Parent = header
	local rl = Instance.new("UIListLayout")
	rl.FillDirection = Enum.FillDirection.Horizontal
	rl.VerticalAlignment = Enum.VerticalAlignment.Center
	rl.Padding = UDim.new(0, 8)
	rl.SortOrder = Enum.SortOrder.LayoutOrder
	rl.Parent = right

	-- sub
	if props.sub then
		Ui.label({
			parent = container, text = props.sub, color = tok.mut,
			font = Ui.FONT_MONO, textSize = 12,
			size = UDim2.new(1, 0, 0, 20), order = 2,
		}).Position = UDim2.new(0, 0, 0, 46)
	end

	-- body (scrollable)
	local body = Instance.new("ScrollingFrame")
	body.Name = "Body"
	body.Size = UDim2.new(1, 0, 1, -86)
	body.Position = UDim2.new(0, 0, 0, 80)
	body.BackgroundTransparency = 1
	body.BorderSizePixel = 0
	body.ScrollBarThickness = 4
	body.ScrollBarImageColor3 = tok.mut
	body.CanvasSize = UDim2.new(0, 0, 0, 0)
	body.AutomaticCanvasSize = Enum.AutomaticSize.Y
	body.Parent = container

	return {
		screen = screen, body = body, header = header, right = right,
		container = container, tokens = tok, theme = theme,
	}
end

-- A grid/list layout helper.
function Ui.list(props)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, props.padding or 10)
	l.FillDirection = props.direction or Enum.FillDirection.Vertical
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Wrap = props.wrap == true
	if props.wrap then
		l.HorizontalAlignment = Enum.HorizontalAlignment.Left
		l.VerticalAlignment = Enum.VerticalAlignment.Top
	end
	l.Parent = props.parent
	return l
end

function Ui.grid(props)
	local g = Instance.new("UIGridLayout")
	g.CellSize = props.cellSize
	g.CellPadding = props.cellPadding or UDim2.new(0, 12, 0, 12)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = props.parent
	return g
end

function Ui.aspect(parent, ratio)
	local a = Instance.new("UIAspectRatioConstraint")
	a.AspectRatio = ratio
	a.AspectType = Enum.AspectType.ScaleWithParentSize
	a.DominantAxis = Enum.DominantAxis.Width
	a.Parent = parent
	return a
end

return Ui
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Utils</string>
          <string name="Source"><![CDATA[--!strict
-- EXOTIC utils — port of src/lib/utils.ts formatters.

local Utils = {}

function Utils.fmtTime(ms: number?): string
	if ms == nil or ms <= 0 then return "--:--.-" end
	local s = math.floor(ms / 1000)
	local m = math.floor(s / 60)
	return string.format("%d:%02d.%d", m, s % 60, math.floor((ms % 1000) / 100))
end

function Utils.fmtClock(ms: number): string
	local s = math.floor(ms / 1000)
	return string.format("%02d:%02d", math.floor(s / 60), s % 60)
end

function Utils.pad2(n: number): string
	return string.format("%02d", n)
end

return Utils
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="24">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="25">
      <Properties>
        <string name="Name">AchievementService</string>
        <string name="Source"><![CDATA[--!strict
-- EXOTIC achievements — server-side evaluation, mirrors the web progress
-- route's achievement logic in src/app/api/progress. Persists unlocks so an
-- achievement only ever fires once.

local DataService = require(script.Parent:WaitForChild("DataService"))

local AchievementService = {}

-- keys in the canonical order used by the UI
AchievementService.KEYS = {
	"first-death", "first-clear", "deaths-25", "deaths-100", "deaths-250",
	"flawless", "speedrun", "trio", "full-clear", "hoarder", "shopper",
}

function AchievementService.clearedCount(progress)
	local c = 0
	for _, p in pairs(progress) do
		if p.completed then c += 1 end
	end
	return c
end

-- data: { deaths, won, timeMs, coins, levelId, par, progress, profile }
-- Returns array of newly-unlocked keys (already persisted).
function AchievementService.evaluate(player, data)
	local newly = {}
	local function unlock(key)
		if DataService.unlockAchievement(player, key) then
			table.insert(newly, key)
		end
	end

	local profile = data.profile or DataService.loadProfile(player)
	local progress = data.progress or DataService.loadProgress(player)
	local totalDeaths = profile.totalDeaths or 0
	local cleared = AchievementService.clearedCount(progress)
	local totalLevels = #require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Catalog")).LEVEL_META

	if (data.deaths or 0) > 0 or totalDeaths > 0 then unlock("first-death") end
	if totalDeaths >= 25 then unlock("deaths-25") end
	if totalDeaths >= 100 then unlock("deaths-100") end
	if totalDeaths >= 250 then unlock("deaths-250") end

	if data.won then
		unlock("first-clear")
		if (data.deaths or 0) == 0 then unlock("flawless") end
		local par = data.par
		if par and par > 0 and (data.timeMs or 0) > 0 and (data.timeMs or 0) <= par * 1000 then
			unlock("speedrun")
		end
		if cleared >= 3 then unlock("trio") end
		if cleared >= totalLevels then unlock("full-clear") end
	end

	if (profile.coins or 0) >= 500 then unlock("hoarder") end

	-- shopper: any non-free purchase owned
	local purchases = DataService.loadPurchases(player)
	local Catalog = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Catalog"))
	for _, item in ipairs(Catalog.SHOP_ITEMS) do
		if item.price > 0 and purchases[item.id] ~= nil then
			unlock("shopper")
			break
		end
	end

	return newly
end

function AchievementService.ownedMap(player)
	local ach = DataService.loadAchievements(player)
	local map = {}
	for _, key in ipairs(AchievementService.KEYS) do
		map[key] = ach[key] or 0
	end
	return map
end

return AchievementService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="26">
      <Properties>
        <string name="Name">DataService</string>
        <string name="Source"><![CDATA[--!strict
-- EXOTIC server persistence — replaces the Postgres profiles/settings/progress/
-- purchases/achievements tables with Roblox DataStores. Adds per-session
-- caching so a player's data is read once and written on change, matching the
-- request/response shape the web API routes expose.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local DataService = {}

local profileStore = DataStoreService:GetDataStore("ExoticProfiles")
local progressStore = DataStoreService:GetDataStore("ExoticProgress")
local settingsStore = DataStoreService:GetDataStore("ExoticSettings")
local purchasesStore = DataStoreService:GetDataStore("ExoticPurchases")
local achievementsStore = DataStoreService:GetDataStore("ExoticAchievements")

local DEFAULT_PROFILE = { coins = 0, totalDeaths = 0, unlockBoost = 0 }
local DEFAULT_SETTINGS = { theme = "dark", sound = true, volume = 60, shake = true, skin = "skin:solid", trail = "trail:none", taunt = "taunt:classic" }

-- userId -> cached doc
local cache: { [number]: any } = {}

local function keyOf(player, prefix)
	return prefix .. "_" .. player.UserId
end

local function readStore(store, key, fallback)
	local ok, data = pcall(function() return store:GetAsync(key) end)
	if ok and data ~= nil then return data end
	return fallback
end

local function writeStore(store, key, data)
	pcall(function() store:SetAsync(key, data) end)
end

function DataService.ensure(player)
	local userId = player.UserId
	local session = cache[userId]
	if session then return session end
	session = {
		profile = readStore(profileStore, keyOf(player, "p"), nil),
		progress = readStore(progressStore, keyOf(player, "pr"), nil),
		settings = readStore(settingsStore, keyOf(player, "s"), nil),
		purchases = readStore(purchasesStore, keyOf(player, "pu"), nil),
		achievements = readStore(achievementsStore, keyOf(player, "a"), nil),
	}
	-- Normalise / default-fill, and migrate fresh installs.
	local profile = session.profile or {}
	profile.coins = profile.coins or 0
	profile.totalDeaths = profile.totalDeaths or 0
	profile.unlockBoost = profile.unlockBoost or 0
	session.profile = profile

	session.progress = session.progress or {}

	local settings = session.settings or {}
	for k, v in pairs(DEFAULT_SETTINGS) do
		if settings[k] == nil then settings[k] = v end
	end
	session.settings = settings

	-- purchases: { [itemId] = true } for permanent, { [itemId] = qty } for consumables
	session.purchases = session.purchases or {}
	-- achievements: { [key] = timestampMs }
	session.achievements = session.achievements or {}

	cache[userId] = session
	return session
end

-- ——— accessors (return live references; call save* to persist) ———
function DataService.loadProfile(player) return DataService.ensure(player).profile end
function DataService.loadProgress(player) return DataService.ensure(player).progress end
function DataService.loadSettings(player) return DataService.ensure(player).settings end
function DataService.loadPurchases(player) return DataService.ensure(player).purchases end
function DataService.loadAchievements(player) return DataService.ensure(player).achievements end

-- consumable quantity (gear). Permanent items are boolean-owned.
function DataService.getQty(player, itemId)
	local purchases = DataService.loadPurchases(player)
	local v = purchases[itemId]
	if v == true then return math.huge end -- permanent
	return tonumber(v) or 0
end

function DataService.addConsumable(player, itemId, delta)
	local purchases = DataService.loadPurchases(player)
	purchases[itemId] = math.max(0, (tonumber(purchases[itemId]) or 0) + delta)
end

function DataService.consume(player, itemId): boolean
	local purchases = DataService.loadPurchases(player)
	local v = purchases[itemId]
	if v == true then return true end -- permanent, unlimited
	local qty = tonumber(v) or 0
	if qty <= 0 then return false end
	purchases[itemId] = qty - 1
	return true
end

function DataService.markOwned(player, itemId)
	DataService.loadPurchases(player)[itemId] = true
end

function DataService.unlockAchievement(player, key): boolean
	local ach = DataService.loadAchievements(player)
	if ach[key] then return false end
	ach[key] = os.time() * 1000
	return true
end

function DataService.saveProfile(player) writeStore(profileStore, keyOf(player, "p"), DataService.loadProfile(player)) end
function DataService.saveProgress(player) writeStore(progressStore, keyOf(player, "pr"), DataService.loadProgress(player)) end
function DataService.saveSettings(player) writeStore(settingsStore, keyOf(player, "s"), DataService.loadSettings(player)) end
function DataService.savePurchases(player) writeStore(purchasesStore, keyOf(player, "pu"), DataService.loadPurchases(player)) end
function DataService.saveAchievements(player) writeStore(achievementsStore, keyOf(player, "a"), DataService.loadAchievements(player)) end

function DataService.saveAll(player)
	DataService.saveProfile(player)
	DataService.saveProgress(player)
	DataService.saveSettings(player)
	DataService.savePurchases(player)
	DataService.saveAchievements(player)
end

Players.PlayerRemoving:Connect(function(player)
	local session = cache[player.UserId]
	if session then
		-- flush then drop the session
		writeStore(profileStore, keyOf(player, "p"), session.profile)
		writeStore(progressStore, keyOf(player, "pr"), session.progress)
		writeStore(settingsStore, keyOf(player, "s"), session.settings)
		writeStore(purchasesStore, keyOf(player, "pu"), session.purchases)
		writeStore(achievementsStore, keyOf(player, "a"), session.achievements)
		cache[player.UserId] = nil
	end
end)

game:BindToClose(function()
	for userId, session in pairs(cache) do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			writeStore(profileStore, keyOf(player, "p"), session.profile)
			writeStore(progressStore, keyOf(player, "pr"), session.progress)
			writeStore(settingsStore, keyOf(player, "s"), session.settings)
			writeStore(purchasesStore, keyOf(player, "pu"), session.purchases)
			writeStore(achievementsStore, keyOf(player, "a"), session.achievements)
		end
	end
end)

return DataService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="27">
      <Properties>
        <string name="Name">LeaderboardService</string>
        <string name="Source"><![CDATA[--!strict
-- EXOTIC leaderboards — three OrderedDataStores mirroring the web leaderboard
-- route (most cleared / fewest deaths / fastest). Adds display-name lookup so
-- the client can render real usernames.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local LeaderboardService = {}

local clearedBoard = DataStoreService:GetOrderedDataStore("LB_Cleared")
local deathsBoard = DataStoreService:GetOrderedDataStore("LB_Deaths")
local speedBoard = DataStoreService:GetOrderedDataStore("LB_Speed")

function LeaderboardService.submit(player, cleared, deaths, timeMs)
	pcall(function() clearedBoard:SetAsync(tostring(player.UserId), cleared) end)
	pcall(function() deathsBoard:SetAsync(tostring(player.UserId), deaths) end)
	if timeMs and timeMs > 0 then
		pcall(function() speedBoard:SetAsync(tostring(player.UserId), timeMs) end)
	end
end

local function displayNames(userIds)
	local names = {}
	for _, id in ipairs(userIds) do
		local ok, name = pcall(function() return Players:GetNameFromUserIdAsync(id) end)
		names[id] = if ok then name else ("Player_" .. id)
	end
	return names
end

-- ascending=false → highest first (cleared); ascending=true → lowest first
-- (deaths, speed). Returns { {rank, userId, name, value}, ... }
local function query(store, ascending, n)
	local ok, pages = pcall(function() return store:GetSortedAsync(ascending, n) end)
	if not ok then return {} end
	local rows = {}
	local page = pages:GetCurrentPage()
	local userIds = {}
	for _, entry in ipairs(page) do
		local id = tonumber(entry.key)
		if id then
			table.insert(rows, { userId = id, value = entry.value })
			table.insert(userIds, id)
		end
	end
	local names = displayNames(userIds)
	for rank, row in ipairs(rows) do
		row.rank = rank
		row.name = names[row.userId] or ("Player_" .. row.userId)
	end
	return rows
end

function LeaderboardService.topCleared(n) return query(clearedBoard, false, n or 50) end
function LeaderboardService.topDeaths(n) return query(deathsBoard, true, n or 50) end
function LeaderboardService.topSpeed(n) return query(speedBoard, true, n or 50) end

function LeaderboardService.fetch(n)
	return {
		cleared = LeaderboardService.topCleared(n),
		deaths = LeaderboardService.topDeaths(n),
		speed = LeaderboardService.topSpeed(n),
	}
end

return LeaderboardService
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="28">
      <Properties>
        <string name="Name">RemoteHandlers</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- EXOTIC server remotes — replaces the Next.js API routes. Every handler
-- mirrors the corresponding route's contract so the client code ports verbatim.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local DataService = require(script.Parent:WaitForChild("DataService"))
local LeaderboardService = require(script.Parent:WaitForChild("LeaderboardService"))
local AchievementService = require(script.Parent:WaitForChild("AchievementService"))

local ITEM_MAP = {}
for _, item in ipairs(Catalog.SHOP_ITEMS) do ITEM_MAP[item.id] = item end

local LEVEL_COUNT = #Catalog.LEVEL_META
local function parFor(levelId)
	local meta = Catalog.LEVEL_META[levelId]
	return meta and meta.par or nil
end
local function deathlessBonusFor(levelId)
	local meta = Catalog.LEVEL_META[levelId]
	return meta and meta.deathlessBonus or 0
end

-- Mirrors providers.tsx: unlockedLevel = min(levelCount, max(1, maxCompleted + 1 + unlockBoost))
local function unlockedFor(progress, profile)
	local maxCompleted = 0
	for id, p in pairs(progress or {}) do
		if p and p.completed then
			local n = tonumber(id) or 0
			if n > maxCompleted then maxCompleted = n end
		end
	end
	local boost = (profile and profile.unlockBoost) or 0
	return math.clamp(maxCompleted + 1 + boost, 1, LEVEL_COUNT)
end

-- ——— FetchState ———
Remotes.FetchState.OnServerInvoke = function(player)
	local session = DataService.ensure(player)
	return {
		account = { id = tostring(player.UserId), username = player.Name, isGuest = false },
		profile = session.profile,
		settings = session.settings,
		progress = session.progress,
		owned = session.purchases,
		unlockedLevel = unlockedFor(session.progress, session.profile),
		achievements = AchievementService.ownedMap(player),
	}
end

-- ——— SubmitRun ———
Remotes.SubmitRun.OnServerInvoke = function(player, payload)
	payload = payload or {}
	local levelId = tonumber(payload.levelId) or 0
	local won = payload.won == true
	local runDeaths = math.clamp(tonumber(payload.runDeaths) or 0, 0, 9999)
	local timeMs = math.clamp(tonumber(payload.timeMs) or 0, 0, 3600000)
	local coins = math.clamp(tonumber(payload.coins) or 0, 0, 500)

	local profile = DataService.loadProfile(player)
	local progress = DataService.loadProgress(player)
	local prev = progress[levelId]

	local firstClear = won and not (prev and prev.completed)
	local earned = 0
	if won then
		earned = coins * Catalog.COIN_VALUE + Catalog.CLEAR_REWARD
		if firstClear then earned += Catalog.FIRST_CLEAR_BONUS end
		if runDeaths == 0 then earned += deathlessBonusFor(levelId) end
		if timeMs > 0 and timeMs <= (parFor(levelId) or math.huge) * 1000 then earned += Catalog.SPEED_BONUS end

		local bestDeaths = prev and prev.bestDeaths
		local bestTimeMs = prev and prev.bestTimeMs
		if not prev then
			prev = { completed = false, attempts = 0 }
			progress[levelId] = prev
		end
		prev.completed = true
		prev.attempts = (prev.attempts or 0) + 1
		prev.bestDeaths = if bestDeaths ~= nil then math.min(bestDeaths, runDeaths) else runDeaths
		prev.bestTimeMs = if bestTimeMs ~= nil and bestTimeMs > 0 then math.min(bestTimeMs, timeMs) else timeMs
	else
		if prev then
			prev.attempts = (prev.attempts or 0) + 1
		elseif runDeaths > 0 then
			progress[levelId] = { completed = false, attempts = 1 }
		end
	end

	profile.coins += earned
	profile.totalDeaths += runDeaths

	DataService.saveProfile(player)
	DataService.saveProgress(player)

	-- leaderboards
	local cleared = AchievementService.clearedCount(progress)
	LeaderboardService.submit(player, cleared, profile.totalDeaths, if won then timeMs else 0)

	-- achievements
	local newAchievements = AchievementService.evaluate(player, {
		deaths = runDeaths, won = won, timeMs = timeMs, coins = profile.coins,
		levelId = levelId, par = parFor(levelId), progress = progress, profile = profile,
	})
	DataService.saveAchievements(player)

	return {
		coinsEarned = earned,
		firstClear = firstClear,
		newAchievements = newAchievements,
		profile = profile,
		unlockedLevel = unlockedFor(progress, profile),
	}
end

-- ——— BuyItem ———
Remotes.BuyItem.OnServerInvoke = function(player, payload)
	payload = payload or {}
	local itemId = payload.itemId
	local item = ITEM_MAP[itemId]
	if not item then return { ok = false, error = "unknown item" } end

	local profile = DataService.loadProfile(player)
	local purchases = DataService.loadPurchases(player)

	-- already own a permanent item?
	if item.consumable == false and purchases[itemId] ~= nil then
		return { ok = false, error = "already owned", coins = profile.coins }
	end
	if profile.coins < item.price then
		return { ok = false, error = "not enough coins", coins = profile.coins }
	end

	profile.coins -= item.price
	if item.consumable then
		DataService.addConsumable(player, itemId, 1)
	else
		DataService.markOwned(player, itemId)
	end
	DataService.saveProfile(player)
	DataService.savePurchases(player)

	-- shopper achievement may trigger on any paid purchase
	local newAch = {}
	if item.price > 0 then
		newAch = AchievementService.evaluate(player, { profile = profile })
		DataService.saveAchievements(player)
	end

	return {
		ok = true, coins = profile.coins,
		owned = DataService.loadPurchases(player),
		newAchievements = newAch,
	}
end

-- ——— UseItem (consume one gear charge) ———
Remotes.UseItem.OnServerInvoke = function(player, payload)
	payload = payload or {}
	local itemId = payload.itemId
	local item = ITEM_MAP[itemId]
	if not item or item.category ~= "gear" then
		return { ok = false, error = "not gear" }
	end
	local ok = DataService.consume(player, itemId)
	if not ok then return { ok = false, error = "none left" } end
	DataService.savePurchases(player)

	local out = { ok = true, qty = DataService.getQty(player, itemId) }
	if itemId == "gear:skip" then
		-- permanently unlock one extra level beyond the natural progression
		local profile = DataService.loadProfile(player)
		profile.unlockBoost = (profile.unlockBoost or 0) + 1
		DataService.saveProfile(player)
		out.unlockedLevel = unlockedFor(DataService.loadProgress(player), profile)
		out.profile = profile
	end
	return out
end

-- ——— PatchSettings ———
Remotes.PatchSettings.OnServerInvoke = function(player, patch)
	patch = patch or {}
	local settings = DataService.loadSettings(player)
	local allowed = { theme = true, sound = true, volume = true, shake = true, skin = true, trail = true, taunt = true }
	for k, v in pairs(patch) do
		if allowed[k] then settings[k] = v end
	end
	DataService.saveSettings(player)
	return { settings = settings }
end

-- ——— FetchLeaderboard ———
Remotes.FetchLeaderboard.OnServerInvoke = function(_player, n)
	return LeaderboardService.fetch(tonumber(n) or 25)
end

-- ——— FetchAchievements ———
Remotes.FetchAchievements.OnServerInvoke = function(player)
	return {
		owned = AchievementService.ownedMap(player),
		defs = Catalog.ACHIEVEMENTS,
	}
end

print("[EXOTIC] server remotes wired")
]]></string>
