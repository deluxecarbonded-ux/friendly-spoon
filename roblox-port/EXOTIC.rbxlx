      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">App</string>
          <string name="Source"><![CDATA[--!strict
-- EXOTIC client app state — the port of src/components/providers.tsx plus a
-- tiny router. A single shared instance holds account/profile/settings/progress
-- and drives screen navigation + toasts for every screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local Audio = require(Shared:WaitForChild("Audio"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local App = {}
App.state = {
	account = nil :: any,
	profile = nil :: any,
	settings = nil :: any,
	progress = nil :: any,
	owned = {} :: { [string]: number },
	unlockedLevel = 1,
	achievements = {} :: { [string]: number },
	theme = "dark",
}
App.ready = false
App.readyCallbacks = {}

-- ——— ScreenGui / Root ———
local function ensureGui()
	local gui = playerGui:FindFirstChild("ExoticGui")
	if not gui then
		gui = Instance.new("ScreenGui")
		gui.Name = "ExoticGui"
		gui.ResetOnSpawn = false
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.IgnoreGuiInset = true
		gui.Parent = playerGui
	end
	local root = gui:FindFirstChild("Root")
	if not root then
		root = Instance.new("Frame")
		root.Name = "Root"
		root.Size = UDim2.new(1, 0, 1, 0)
		root.BackgroundTransparency = 1
		root.Parent = gui
	end
	return gui, root
end

App.gui, App.root = ensureGui()

-- ——— theme ———
function App.palette()
	return Catalog.PALETTE[App.state.theme] or Catalog.PALETTE.dark
end

function App.setTheme(theme)
	App.state.theme = theme
	if App.onThemeChanged then App.onThemeChanged(theme) end
end

-- ——— toast system ———
local toastHolder = nil
local toastTimer = nil
local function ensureToastHolder()
	if toastHolder and toastHolder.Parent then return toastHolder end
	toastHolder = Instance.new("Frame")
	toastHolder.Name = "ToastHolder"
	toastHolder.Size = UDim2.new(1, 0, 0, 60)
	toastHolder.Position = UDim2.new(0, 0, 0.12, 0)
	toastHolder.BackgroundTransparency = 1
	toastHolder.Parent = App.root
	return toastHolder
end

local TONES = {
	error = Color3.fromHex("101010"),
	success = Color3.fromHex("101010"),
	silent = Color3.fromHex("101010"),
}

function App.notify(title, sub, tone)
	local holder = ensureToastHolder()
	for _, c in ipairs(holder:GetChildren()) do c:Destroy() end
	local bg = App.state.theme == "dark" and Color3.fromHex("fafafa") or Color3.fromHex("101010")
	local fg = App.state.theme == "dark" and Color3.fromHex("0b0b0c") or Color3.fromHex("f1f1ee")

	local pill = Instance.new("Frame")
	pill.Size = UDim2.new(0, 10, 0, 56)
	pill.AutomaticSize = Enum.AutomaticSize.X
	pill.Position = UDim2.new(0.5, 0, 0, 0)
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.BackgroundColor3 = bg
	pill.BorderSizePixel = 0
	pill.Parent = holder
	local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 28); corner.Parent = pill
	local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0, 22); pad.PaddingRight = UDim.new(0, 22); pad.Parent = pill

	local stack = Instance.new("Frame")
	stack.Size = UDim2.new(0, 0, 1, 0)
	stack.AutomaticSize = Enum.AutomaticSize.X
	stack.BackgroundTransparency = 1
	stack.Parent = pill
	local layout = Instance.new("UIListLayout"); layout.FillDirection = Enum.FillDirection.Horizontal; layout.VerticalAlignment = Enum.VerticalAlignment.Center; layout.Parent = stack

	local col = Instance.new("Frame")
	col.AutomaticSize = Enum.AutomaticSize.Y
	col.Size = UDim2.new(0, 0, 1, 0)
	col.BackgroundTransparency = 1
	col.Parent = stack
	local cl = Instance.new("UIListLayout"); cl.Parent = col

	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.new(0, 0, 0, 18)
	t.AutomaticSize = Enum.AutomaticSize.X
	t.Text = title
	t.TextColor3 = fg
	t.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json", Enum.FontWeight.Bold)
	t.TextSize = 14
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.Parent = col
	if sub then
		local s = Instance.new("TextLabel")
		s.BackgroundTransparency = 1
		s.Size = UDim2.new(0, 0, 0, 14)
		s.AutomaticSize = Enum.AutomaticSize.X
		s.Text = sub
		s.TextTransparency = 0.35
		s.TextColor3 = fg
		s.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json", Enum.FontWeight.Regular)
		s.TextSize = 11
		s.TextXAlignment = Enum.TextXAlignment.Left
		s.Parent = col
	end

	Audio.sfx.toast()
	task.delay(2.4, function()
		if pill.Parent then pill:Destroy() end
	end)
end

-- ——— router ———
App.screens = {} :: { [string]: any }
App.currentScreen = nil :: string?
App.pendingScreen = nil :: string?

function App.register(name, screen)
	App.screens[name] = screen
	-- if a navigation to this screen was requested before it registered, run it
	if App.pendingScreen == name then
		App.pendingScreen = nil
		App.navigate(name)
	end
end

function App.navigate(name, arg)
	if not App.screens[name] then
		App.pendingScreen = name
		return
	end
	if App.currentScreen == name then
		local s = App.screens[name]
		if s.onEnter then
			task.spawn(function()
				local ok, err = pcall(function() s:onEnter(arg) end)
				if not ok then warn("[EXOTIC] onEnter '" .. name .. "': " .. tostring(err)) end
			end)
		end
		return
	end
	if App.currentScreen then
		local prev = App.screens[App.currentScreen]
		if prev then
			if prev.onExit then
				-- guarded so a throwing onExit can't block the next screen showing
				pcall(function() prev:onExit() end)
			end
			if prev.screen then prev.screen.Visible = false end
		end
	end
	local s = App.screens[name]
	if s.screen then s.screen.Visible = true end
	App.currentScreen = name
	if s.onEnter then
		task.spawn(function()
			local ok, err = pcall(function() s:onEnter(arg) end)
			if not ok then warn("[EXOTIC] onEnter '" .. name .. "': " .. tostring(err)) end
		end)
	end
end

-- ——— data ———
function App.applyState(data)
	if not data then return end
	App.state.account = data.account
	App.state.profile = data.profile
	App.state.settings = data.settings
	App.state.progress = data.progress or {}
	App.state.owned = data.owned or {}
	App.state.unlockedLevel = data.unlockedLevel or 1
	App.state.achievements = data.achievements or {}
	if data.settings and data.settings.theme then App.state.theme = data.settings.theme end
	Audio.sfx.configure({
		enabled = if data.settings then data.settings.sound ~= false else true,
		volume = if data.settings then (data.settings.volume or 60) / 100 else 0.6,
	})
end

function App.whenReady(cb)
	if App.ready then
		task.spawn(cb)
	else
		table.insert(App.readyCallbacks, cb)
	end
end

function App.refresh()
	local ok, data = pcall(function() return Remotes.FetchState:InvokeServer() end)
	if ok then App.applyState(data) end
	return ok
end

function App.start()
	task.spawn(function()
		Audio.sfx.unlock()
		App.refresh()
		App.ready = true
		if App.onReady then task.spawn(App.onReady) end
		for _, cb in ipairs(App.readyCallbacks) do task.spawn(cb) end
		table.clear(App.readyCallbacks)
	end)
end

-- currency helper
function App.coins()
	return if App.state.profile then App.state.profile.coins or 0 else 0
end

function App.ownedQty(id)
	return App.state.owned[id] or 0
end

return App
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Audio</string>
          <string name="Source"><![CDATA[--!strict
-- EXOTIC audio — port of src/game/audio.ts.
--
-- The web build synthesizes every effect with WebAudio oscillators/noise. Luau
-- cannot create oscillators, so this module maps each named effect onto the
-- closest sound that ships with Roblox (rbxasset://), preserving the timing,
-- layering and config (enabled/volume) of the original. Every public method
-- matches the web `sfx` API one-for-one so callers port verbatim.

local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local Audio = {}
local sfx = {}

local state = {
	enabled = true,
	volume = 0.6,
	ambientStarted = false,
	ambientAllowed = false,
}

-- name → { id, baseVolume, playbackSpeed }
local LIB = {
	jump = { "rbxasset://sounds/action_jump.mp3", 0.35, 1.0 },
	land = { "rbxasset://sounds/action_jump_land.mp3", 0.25, 1.0 },
	spring = { "rbxasset://sounds/action_fingflick.mp3", 0.4, 1.2 },
	coin = { "rbxasset://sounds/bell.mp3", 0.4, 1.4 },
	die = { "rbxasset://sounds/uuhhh.mp3", 0.6, 1.0 },
	bump = { "rbxasset://sounds/snap.mp3", 0.5, 1.0 },
	checkpoint = { "rbxasset://sounds/bell.mp3", 0.4, 1.0 },
	flip = { "rbxasset://sounds/electronicpingshort.wav", 0.5, 0.8 },
	reverse = { "rbxasset://sounds/electronicpingshort.wav", 0.45, 0.6 },
	reveal = { "rbxasset://sounds/electronicpingshort.wav", 0.5, 1.3 },
	spike = { "rbxasset://sounds/splat.mp3", 0.4, 1.0 },
	shift = { "rbxasset://sounds/electronicpingshort.wav", 0.5, 1.1 },
	win = { "rbxasset://sounds/bell.mp3", 0.5, 1.6 },
	click = { "rbxasset://sounds/buttonpress.wav", 0.4, 1.0 },
	denied = { "rbxasset://sounds/buttonrollover.wav", 0.4, 0.8 },
	buy = { "rbxasset://sounds/bell.mp3", 0.4, 1.2 },
	hover = { "rbxasset://sounds/buttonrollover.wav", 0.15, 1.6 },
	nav = { "rbxasset://sounds/button.wav", 0.3, 1.0 },
	select = { "rbxasset://sounds/buttonpress.wav", 0.35, 1.2 },
	toggle = { "rbxasset://sounds/buttonpress.wav", 0.35, 0.9 },
	open = { "rbxasset://sounds/button.wav", 0.3, 1.3 },
	close = { "rbxasset://sounds/button.wav", 0.3, 0.7 },
	type = { "rbxasset://sounds/buttonrollover.wav", 0.12, 2.0 },
	slider = { "rbxasset://sounds/buttonrollover.wav", 0.25, 1.4 },
	toast = { "rbxasset://sounds/electronicpingshort.wav", 0.3, 1.5 },
	success = { "rbxasset://sounds/bell.mp3", 0.4, 1.3 },
	achievement = { "rbxasset://sounds/bell.mp3", 0.5, 1.8 },
	fieldError = { "rbxasset://sounds/buttonrollover.wav", 0.3, 0.6 },
	pause = { "rbxasset://sounds/button.wav", 0.35, 0.8 },
	resume = { "rbxasset://sounds/button.wav", 0.35, 1.1 },
	restart = { "rbxasset://sounds/buttonpress.wav", 0.4, 0.7 },
	levelStart = { "rbxasset://sounds/electronicpingshort.wav", 0.45, 1.0 },
	boot = { "rbxasset://sounds/bell.mp3", 0.4, 1.0 },
	unlock = { "rbxasset://sounds/bell.mp3", 0.45, 1.5 },
}

local templates: { [string]: Sound } = {}
local live: { [string]: { Sound } } = {}

local function template(name: string): Sound?
	local entry = LIB[name]
	if not entry then return nil end
	local t = templates[name]
	if not t then
		t = Instance.new("Sound")
		t.Name = "Exotic_" .. name
		t.SoundId = entry[1]
		t.Volume = entry[2]
		t.PlaybackSpeed = entry[3]
		t.Parent = SoundService
		templates[name] = t
	end
	return t
end

local function play(name: string, speedMul: number?)
	if not state.enabled then return end
	local t = template(name)
	if not t then return end
	local entry = LIB[name]
	local list = live[name] or {}
	live[name] = list

	-- reuse an idle instance if one exists, else clone; cap concurrency
	local inst: Sound? = nil
	for _, s in ipairs(list) do
		if not s.IsPlaying then inst = s; break end
	end
	if not inst then
		if #list >= 4 then
			inst = list[1]
			table.remove(list, 1)
		else
			inst = t:Clone()
			inst.Parent = SoundService
			table.insert(list, inst)
		end
	end
	inst.Volume = (entry[2]) * state.volume
	inst.PlaybackSpeed = (entry[3]) * (speedMul or 1)
	inst.TimePosition = 0
	inst:Play()
	Debris:AddItem(inst, 3)
end

-- ——— public API (mirrors web sfx) ———
function sfx.configure(opts)
	if opts.enabled ~= nil then state.enabled = opts.enabled end
	if opts.volume ~= nil then state.volume = math.clamp(opts.volume, 0, 1) end
end
function sfx.unlock()
	state.ambientAllowed = true
end
function sfx.startAmbient() state.ambientStarted = true end
function sfx.stopAmbient() state.ambientStarted = false end

local names = {}
for name in pairs(LIB) do table.insert(names, name) end
for _, name in ipairs(names) do
	sfx[name] = function(speedMul: number?)
		play(name, speedMul)
	end
end

-- slight variations for layered effects (win chord, coin double, etc.)
sfx.coin = function()
	play("coin", 1.0)
	play("coin", 1.5)
end
sfx.win = function()
	play("win", 1.0)
	task.delay(0.09, function() play("win", 1.3) end)
	task.delay(0.18, function() play("win", 1.6) end)
end
sfx.achievement = function()
	play("achievement", 1.0)
	task.delay(0.08, function() play("achievement", 1.3) end)
	task.delay(0.16, function() play("achievement", 1.6) end)
end
sfx.die = function()
	play("die", 1.0)
	play("spike", 0.7)
end
sfx.explode = function()
	play("spike", 0.8)
	play("bump", 0.8)
end

Audio.sfx = sfx
Audio.getState = function()
	return state
end

return Audio
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Catalog</string>
          <string name="Source">-- EXOTIC catalog ported to Luau
local Catalog = {}

Catalog.SHOP_ITEMS = {
  {id="skin:solid",category="skin",name="SLAB",blurb="The default. Dense, honest, doomed.",price=0,consumable=false},
  {id="skin:hollow",category="skin",name="HOLLOW",blurb="An empty box. Like your confidence.",price=160,consumable=false},
  {id="skin:diagonal",category="skin",name="WEDGE",blurb="Split personality, 45 degrees.",price=200,consumable=false},
  {id="skin:checker",category="skin",name="CHECKER",blurb="Four pixels of pure stability.",price=240,consumable=false},
  {id="skin:ghost",category="skin",name="PHANTOM",blurb="Half-here. Fully breakable.",price=320,consumable=false},
  {id="trail:none",category="trail",name="BARE",blurb="No trail. Leave no trace.",price=0,consumable=false},
  {id="trail:pixels",category="trail",name="PIXELRAIN",blurb="Shed tiny squares while sprinting.",price=180,consumable=false},
  {id="trail:comet",category="trail",name="COMET",blurb="A shrinking tail of speed.",price=220,consumable=false},
  {id="trail:shadow",category="trail",name="AFTERIMAGE",blurb="Your past selves, lagging behind.",price=300,consumable=false},
  {id="gear:reveal",category="gear",name="TRAP-SCOPE",blurb="Every trap is invisible until it springs. This flashes them all for 2 seconds.",price=70,consumable=true},
  {id="gear:pass",category="gear",name="ANCHOR",blurb="Drop one extra checkpoint, anywhere, mid-run.",price=130,consumable=true},
  {id="gear:skip",category="gear",name="SKIP TOKEN",blurb="Permanently unlock the level after your current one.",price=400,consumable=true},
  {id="taunt:classic",category="taunt",name="CLASSIC RAGE",blurb="The original verbal slap.",price=0,consumable=false},
  {id="taunt:corporate",category="taunt",name="CORPORATE",blurb="Deaths, now with HR-approved feedback.",price=140,consumable=false},
  {id="taunt:poetic",category="taunt",name="POETIC",blurb="Every fall, a tiny tragedy.",price=200,consumable=false},
  {id="taunt:minimal",category="taunt",name="MINIMAL",blurb="No words. Just judgment.",price=120,consumable=false},
}

Catalog.TAUNTS = {
  classic = {"AGAIN.","THE FLOOR LIED. YOU BELIEVED.","YOU WALKED INTO THAT ONE.","SKILL ISSUE NOT FOUND. STILL LOOKING.","THAT SPIKE WAS JUST MADE.","THE SIGN SAID NO. YOU SAID YES.","IMPRESSIVE. TECHNICALLY.","SO CLOSE. SO, SO FAR.","THE TUTORIAL WAS EASIER THAN THIS.","PRESSING JUMP DOES NOT MAKE IT WORK.","RIP AND UNTIL NEXT TIME.","THIS LEVEL REMEMBERS YOU."},
  corporate = {"FEEDBACK LOGGED. TRY AGAIN.","YOUR PERFORMANCE HAS BEEN NOTED.","WE'VE DECIDED TO GO IN A DIFFERENT DIRECTION.","PLEASE RESCHEDULE YOUR SUCCESS.","THIS MEETING COULD HAVE BEEN A RESPAWN.","GREAT ENERGY. WRONG TRAJECTORY.","ACTION ITEM: STOP DYING.","CIRCLE BACK WHEN YOU CAN JUMP."},
  poetic = {"THE VOID ACCEPTS YOUR OFFERING.","A SMALL SQUARE, A GRAND FALL.","GRAVITY: THE OLDEST POEM.","YOU FELL, AS ALL THINGS MUST.","THE PIT KNOWS YOUR NAME NOW.","EACH DEATH, A VERSE. THIS ONE RHYMES.","THE FLOOR YOU TRUSTED HAS MOVED ON.","SILENCE. SQUARES. TRAGEDY."},
  minimal = {"NOPE.","LOL.","...","NO.","AGAIN?","HM.","OOF.","WOW.","OKAY."},
}
Catalog.FAKE_FLAG_MESSAGE = "THE FLAG WAS A LIE"
Catalog.FAKE_CHECKPOINT_MESSAGE = "NOT A CHECKPOINT"

Catalog.ACHIEVEMENTS = {
  {key="first-death",name="WELCOME TO EXOTIC",desc="Die for the first time. The game thanks you."},
  {key="first-clear",name="ACTUALLY NOT BAD",desc="Complete your first level."},
  {key="deaths-25",name="COMMITTED",desc="Reach 25 total deaths."},
  {key="deaths-100",name="CENTURY OF PAIN",desc="Reach 100 total deaths."},
  {key="deaths-250",name="PROFESSIONAL VICTIM",desc="Reach 250 total deaths."},
  {key="flawless",name="UNTOUCHABLE",desc="Complete a level without dying."},
  {key="speedrun",name="AGAINST THE CLOCK",desc="Beat a level under par time."},
  {key="trio",name="THIRD TIME'S THE CHARM",desc="Complete 3 different levels."},
  {key="full-clear",name="EXOTIC CERTIFIED",desc="Complete every level."},
  {key="hoarder",name="SQUARE RICH",desc="Hold 500 coins at once."},
  {key="shopper",name="ENABLING THE ECONOMY",desc="Buy something from the shop."},
}

Catalog.LEVEL_META = {
  {id=1,name="TRUST ISSUES",sub="The floor has opinions.",par=25,deathlessBonus=40},
  {id=2,name="FALSE PROMISES",sub="Flags may be less real than they appear.",par=35,deathlessBonus=50},
  {id=3,name="AIR IS A LIE",sub="Invisible things ruin everything.",par=40,deathlessBonus=60},
  {id=4,name="GRAVITY FLIPS",sub="Up is a suggestion.",par=50,deathlessBonus=70},
  {id=5,name="THE COLLECTOR",sub="Coins are bait. You are the fish.",par=55,deathlessBonus=80},
  {id=6,name="EXOTIC",sub="The final betrayal.",par=70,deathlessBonus=120},
}

Catalog.COIN_VALUE=5; Catalog.CLEAR_REWARD=40; Catalog.FIRST_CLEAR_BONUS=60; Catalog.SPEED_BONUS=40

Catalog.PALETTE = {
  light = {bg="#f1f1ee",tile="#191919",player="#000000",accent="#7c7c7c",subtle="#a2a2a2",far="#000000",text="#000000"},
  dark = {bg="#0b0b0c",tile="#e8e8e6",player="#fafafa",accent="#8c8c8c",subtle="#5c5c5c",far="#ffffff",text="#fafafa"},
}

Catalog.ITEM_MAP = {}
for _, item in ipairs(Catalog.SHOP_ITEMS) do Catalog.ITEM_MAP[item.id] = item end

Catalog.categoryLabel = function(c)
  return c == "skin" and "SKINS" or c == "trail" and "TRAILS" or c == "gear" and "GEAR" or "TAUNTS"
end

Catalog.CATEGORIES = { "skin", "trail", "gear", "taunt" }

return Catalog</string>
