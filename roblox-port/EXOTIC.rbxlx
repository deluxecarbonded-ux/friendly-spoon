  {12, 3, "S"},
  {13, 11, "DD"},
  {14, 11, "^^^^"},
  {11, 11, "CCCC"},
  {13, 15, R("#", 14)},
  {14, 15, R("#", 14)},
  {12, 17, "F"},
  {12, 19, "B"},
  {12, 24, "b"},
  {12, 21, "&gt;"},
  {12, 27, "P"},
  {10, 30, "HH"},
  {14, 29, "^^^^"},
  {11, 25, "=="},
  {11, 28, "__"},
  {10, 25, "CC"},
  {10, 28, "cC"},
  {13, 33, R("#", 14)},
  {14, 33, R("#", 14)},
  {10, 35, "CC"},
  {10, 36, "c"},
  {12, 34, "O"},
  {12, 38, "E"},
  {12, 39, "&gt;"},
  {12, 43, "X"},
