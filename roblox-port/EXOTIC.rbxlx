    { type = "spikefall", x = 33, y = 7, w = 5, h = 5, once = true, at = {34, 35}, landY = 11 },
    { type = "goalshift", x = 50, y = 8, w = 4, h = 5, once = true, text = "COME CLOSER.", dx = 12 },
    { type = "goalshift", x = 62, y = 8, w = 4, h = 5, once = true, text = "ALMOST HAD IT.", dx = 12 },
    { type = "msg", x = 15, y = 8, w = 9, h = 4, once = true, text = "ONE CRATE HAS A COIN. ONE HAS A BOMB." },
    { type = "msg", x = 23, y = 6, w = 6, h = 4, once = true, text = "THAT PLATFORM IS DEFINITELY A PLATFORM." },
  },
}

local L3 = {
