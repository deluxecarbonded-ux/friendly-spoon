  {12, 66, "&gt;"},
  {12, 67, "G"}
  }),
  events = {
    { type = "spikefall", x = 50, y = 7, w = 5, h = 5, once = true, text = "SURPRISE.", at = {51, 52, 53}, landY = 11 },
    { type = "msg", x = 52, y = 8, w = 3, h = 4, once = true, text = "THE EXIT. PROMISE." },
    { type = "msg", x = 15, y = 8, w = 8, h = 4, once = true, text = "ONE CRATE PAYS. ONE CRATE EXPLODES." },
    { type = "msg", x = 31, y = 8, w = 8, h = 4, once = true, text = "THE HIGH ROAD IS FREE. TRUST ME." },
  },
}

local L2 = {
  id = 2,
  name = "FALSE PROMISES",
  tip = "TIP: FLAGS MAY BE LESS REAL THAN THEY APPEAR. SO ARE THE BOMBS.",
  par = 35,
  W = 84,
