# Supabase Postgres (session-mode pooler recommended for LISTEN/NOTIFY)
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase project API (anon key is safe for public, read-only content)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Resend email (welcome emails on signup)
RESEND_API_KEY=re_<key>
RESEND_FROM_EMAIL=Exotic <Exotic@DevilExotix.com>

# Public base URL (used for OpenGraph image URLs)
NEXT_PUBLIC_BASE_URL=https://devilexotix.com
